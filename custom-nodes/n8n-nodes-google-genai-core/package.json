{
  "name": "n8n-nodes-google-genai-core",
  "version": "1.0.0",
  "description": "Core package for Google GenAI integration: credentials, client wrapper, GCS upload, and polling utilities",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "google",
    "genai",
    "gemini",
    "vertex-ai",
    "veo",
    "gcs"
  ],
  "license": "MIT",
  "homepage": "https://github.com/fsebbah/n8n-workflows",
  "author": {
    "name": "fsebbah"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fsebbah/n8n-workflows.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GoogleVertexAiApi.credentials.js",
      "dist/credentials/GoogleAiStudioApi.credentials.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@google-cloud/storage": "^7.7.0",
    "@google-cloud/aiplatform": "^3.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "~5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
