{
  "name": "n8n-nodes-contacts-dynamic",
  "version": "1.0.0",
  "description": "n8n node for Google Contacts with dynamic OAuth token support",
  "keywords": [
    "n8n-community-node-package",
    "google",
    "contacts",
    "people",
    "oauth",
    "dynamic"
  ],
  "license": "MIT",
  "main": "dist/nodes/ContactsToolDynamic/ContactsToolDynamic.node.js",
  "scripts": {
    "build": "tsc && cp nodes/ContactsToolDynamic/contacts.svg dist/nodes/ContactsToolDynamic/",
    "dev": "tsc --watch"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/ContactsToolDynamic/ContactsToolDynamic.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "~5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
