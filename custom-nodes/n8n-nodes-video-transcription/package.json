{
  "name": "n8n-nodes-video-transcription",
  "version": "0.1.0",
  "description": "n8n node for video transcription using Google Gemini multimodal AI",
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "video",
    "transcription",
    "gemini",
    "multimodal",
    "speech-to-text",
    "speaker-diarization"
  ],
  "license": "MIT",
  "homepage": "",
  "author": {
    "name": "fsebbah"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fsebbah/n8n-workflows.git"
  },
  "main": "dist/nodes/VideoTranscription/VideoTranscription.node.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/VideoTranscription/VideoTranscription.node.js"
    ],
    "credentials": []
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "@google-cloud/aiplatform": "^3.10.0",
    "ytdl-core": "^4.11.5"
  }
}
