{
  "name": "n8n-nodes-email-imap-dynamic",
  "version": "1.0.0",
  "description": "IMAP node with per-request connection parameters (BYOT) for multi-tenant architectures",
  "keywords": ["n8n-community-node-package", "n8n", "imap", "email", "multi-tenant", "byot"],
  "license": "MIT",
  "homepage": "https://github.com/fsebbah/n8n-workflows",
  "author": { "name": "fsebbah" },
  "repository": { "type": "git", "url": "https://github.com/fsebbah/n8n-workflows.git" },
  "main": "dist/nodes/EmailImapToolDynamic/EmailImapToolDynamic.node.js",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": ["dist/nodes/EmailImapToolDynamic/EmailImapToolDynamic.node.js"]
  },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "cp -r nodes/EmailImapToolDynamic/*.svg dist/nodes/EmailImapToolDynamic/ 2>/dev/null || true",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "files": ["dist"],
  "dependencies": {
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "~5.3.0"
  },
  "peerDependencies": { "n8n-workflow": "*" }
}
