# =============================================================================
# n8n-workflows Configuration
# =============================================================================
# Copier ce fichier vers .env.local et adapter les valeurs
# cp .env.local.example .env.local
# =============================================================================

# =============================================================================
# n8n Docker Configuration
# =============================================================================

# PostgreSQL Database
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=databases.local
DB_POSTGRESDB_PORT=5435
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=n8npass

# n8n Encryption Key (CRITIQUE - identique sur tous les serveurs)
# Récupérer depuis l'ancien serveur: cat ~/.n8n/config
N8N_ENCRYPTION_KEY=your-encryption-key-from-config

# n8n Server
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://pi6.local:5678/
N8N_WEBHOOK_BASE_URL=http://pi6.local:5678/webhook

# n8n Features
N8N_RUNNERS_ENABLED=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_WORKFLOW_HISTORY_ENABLED=false
N8N_SECURE_COOKIE=false
N8N_DISABLE_UI=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_GIT_NODE_DISABLE_BARE_REPOS=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# Timezone
GENERIC_TIMEZONE=Europe/Paris
TZ=Europe/Paris

# Executions
EXECUTIONS_MODE=regular
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# DNS Resolution (IPs réelles pour Docker)
DATABASES_LOCAL_IP=192.168.1.X
PI6_LOCAL_IP=192.168.1.X

# =============================================================================
# n8n API Configuration
# =============================================================================
N8N_API_URL=http://pi6.local:5678/api/v1
N8N_API_KEY=your-n8n-api-key

# n8n MCP Server
N8N_MCP_ENDPOINT=http://pi6.local:5678/mcp-server/http
N8N_MCP_TOKEN=your-mcp-token

# =============================================================================
# LLM API Keys
# =============================================================================
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
MISTRAL_API_KEY=xxx
LLM_INTENTION_MODEL=claude-3-haiku-20240307

# =============================================================================
# Torah API
# =============================================================================
API_URL=http://pi6.local:3031
TORAH_API_URL=http://pi6.local:3031

# =============================================================================
# Discord Bot
# =============================================================================
DISCORD_TOKEN=Bot xxx
DISCORD_URL_CHANNEL=https://discord.com/api/v10/channels/
N8N_WEBHOOK_URL=http://pi6.local:5678/webhook/torah-discord-message

# =============================================================================
# Security
# =============================================================================
JWT_SECRET_KEY=your-secret-jwt-key
ADMIN_PASSWORD=your-admin-password
ADMIN_TOKEN=your-admin-token

# =============================================================================
# Remote Server (for video/slide extraction)
# =============================================================================
EXTRACT_SERVER=user@server.local
SSH_PORT=2222
REMOTE_DIR=~/extract-slides

# =============================================================================
# Other
# =============================================================================
STRIPE_WEBHOOK_URL=https://stripe.example.com
HOST=127.0.0.1
PORT=8000
WORKFLOW_DB_PATH=database/workflows.db
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
