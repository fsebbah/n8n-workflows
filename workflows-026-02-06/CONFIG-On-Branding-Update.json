              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "update-branding-0005",
      "name": "Has Project?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
