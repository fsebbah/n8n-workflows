{
  "name": "LEARNING - Send Reminder",
  "active": true,
  "nodes": [
    {
      "id": "schedule-trigger",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "get-all-guilds",
      "name": "Get All Guilds",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_URL }}/api/v1/guilds",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "active",
              "value": "true"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "check-has-guilds",
      "name": "Has Guilds?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.data?.length || $json.guilds?.length || 0 }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "extract-guilds",
      "name": "Extract Guild IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ],
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst guilds = response.data || response.guilds || [];\n\n// Return each guild as a separate item\nreturn guilds.map(guild => ({\n  json: {\n    guild_id: guild.id || guild.guild_id,\n    guild_name: guild.name || guild.guild_name || 'Unknown'\n  }\n}));"
      }
    },
    {
      "id": "get-inactive-enrollments",
      "name": "Get Inactive Enrollments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_URL }}/api/v1/enrollments/inactive",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "guild_id",
              "value": "={{ $json.guild_id }}"
            },
            {
              "name": "days_threshold",
              "value": "7"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "process-enrollments",
      "name": "Process Enrollments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        200
      ],
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst enrollments = response.enrollments || [];\n\nif (enrollments.length === 0) {\n  return { json: { skip: true, message: 'No inactive enrollments' } };\n}\n\n// Return each enrollment as separate item with personalized message\nreturn enrollments.map(enrollment => {\n  const progress = enrollment.progress_percent || 0;\n  const daysInactive = enrollment.days_inactive || 7;\n  \n  let message;\n  if (progress < 25) {\n    message = `👋 Salut ! Tu as commencé \"${enrollment.course_title}\" mais on ne t'a pas vu depuis ${daysInactive} jours. Reviens continuer ton apprentissage ! 🍳`;\n  } else if (progress < 75) {\n    message = `🎯 Tu es à ${Math.round(progress)}% du cours \"${enrollment.course_title}\" ! Plus que quelques leçons pour finir. On t'attend ! 👨‍🍳`;\n  } else {\n    message = `🏆 Tu es si proche de terminer \"${enrollment.course_title}\" (${Math.round(progress)}%) ! Viens décrocher ton badge de complétion ! 🎓`;\n  }\n  \n  return {\n    json: {\n      skip: false,\n      discord_id: enrollment.discord_id,\n      display_name: enrollment.display_name,\n      course_title: enrollment.course_title,\n      progress_percent: progress,\n      days_inactive: daysInactive,\n      message: message\n    }\n  };\n});"
      }
    },
    {
      "id": "filter-skip",
      "name": "Filter Skip",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        1560,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "send-discord-dm",
      "name": "Send Discord DM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_API_URL }}/users/@me/channels",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bot {{ $env.DISCORD_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"recipient_id\": \"{{ $json.discord_id }}\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "merge-dm-data",
      "name": "Merge DM Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        2000,
        200
      ],
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      }
    },
    {
      "id": "send-message",
      "name": "Send Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2220,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_API_URL }}/channels/{{ $json.id }}/messages",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bot {{ $env.DISCORD_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"{{ $json.message }}\",\n  \"embeds\": [{\n    \"title\": \"📚 {{ $json.course_title }}\",\n    \"description\": \"Progression: {{ Math.round($json.progress_percent) }}%\",\n    \"color\": 5814783,\n    \"footer\": {\n      \"text\": \"Clique pour continuer ton apprentissage !\"\n    }\n  }]\n}",
        "options": {
          "timeout": 10000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "no-guilds",
      "name": "No Guilds",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        900,
        400
      ],
      "parameters": {}
    },
    {
      "id": "sticky-note-doc",
      "name": "Documentation",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        60
      ],
      "parameters": {
        "color": 6,
        "width": 700,
        "height": 220,
        "content": "## LEARNING - Send Reminder (RFC-022) - Multi-Guild\n\n**Trigger:** Daily at 10:00 AM (cron: 0 10 * * *)\n\n**Process:**\n1. Fetch ALL active guilds from API\n2. For each guild, fetch inactive enrollments (7+ days)\n3. Personalize message based on progress:\n   - < 25%: Encourage to start\n   - 25-75%: Motivate to continue\n   - > 75%: Push to complete\n4. Send Discord DM to each inactive learner\n\n**No DEFAULT_GUILD_ID needed** - processes all guilds automatically"
      }
    }
  ],
  "connections": {
    "Daily Schedule": {
