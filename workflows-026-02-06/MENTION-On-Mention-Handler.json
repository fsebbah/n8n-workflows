    {
      "parameters": {
        "jsCode": "// ============================================\n// MERGE PROJECT + DATA + BRANDING (RFC-009 v2)\n// ============================================\n\nconst response = $input.first().json;\nconst validatedInput = $('Validate Input').first().json;\n\n// API returns: { success, project_id, branding: { name, scope_prompt, ... } }\nconst brandingData = response.branding || {};\n\nreturn {\n  project_id: response.project_id,\n  data: validatedInput.data,\n  llm_config: validatedInput.llm_config,\n  branding: {\n    name: brandingData.name || null,\n    scope_prompt: brandingData.scope_prompt || null,\n    out_of_scope_message: brandingData.out_of_scope_message || null\n  }\n};"
      },
