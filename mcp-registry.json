{
  "version": "1.0",
  "n8n": {
    "host": "pi6.local",
    "port": 5678,
    "protocol": "http"
  },
  "services": {
    "gmail": {
      "name": "Gmail MCP Server",
      "webhook_path": "/webhook/mcp-gmail",
      "description": "Gmail API operations via n8n workflow with dynamic OAuth token",
      "operations": {
        "message": {
          "get": {
            "description": "Get a specific email by ID",
            "params": ["message_id"]
          },
          "getAll": {
            "description": "Search/list emails",
            "params": ["query?", "sender?", "received_after?", "received_before?", "return_all?"]
          },
          "send": {
            "description": "Send a new email",
            "params": ["to", "subject", "body", "cc?", "bcc?"]
          },
          "reply": {
            "description": "Reply to an email",
            "params": ["message_id", "message", "cc?", "bcc?"]
          },
          "delete": {
            "description": "Delete an email",
            "params": ["message_id"]
          },
          "markAsRead": {
            "description": "Mark email as read",
            "params": ["message_id"]
          },
          "markAsUnread": {
            "description": "Mark email as unread",
            "params": ["message_id"]
          },
          "addLabels": {
            "description": "Add labels to an email",
            "params": ["message_id", "label_ids"]
          },
          "removeLabels": {
            "description": "Remove labels from an email",
            "params": ["message_id", "label_ids"]
          }
        },
        "label": {
          "getAll": {
            "description": "List all labels",
            "params": ["return_all?"]
          },
          "get": {
            "description": "Get a specific label",
            "params": ["label_id"]
          },
          "create": {
            "description": "Create a new label",
            "params": ["label_name"]
          },
          "delete": {
            "description": "Delete a label",
            "params": ["label_id"]
          }
        },
        "draft": {
          "create": {
            "description": "Create a draft email",
            "params": ["subject", "message", "cc?", "bcc?"]
          },
          "get": {
            "description": "Get a specific draft",
            "params": ["draft_id"]
          },
          "getAll": {
            "description": "List all drafts",
            "params": ["return_all?", "include_spam_trash?"]
          },
          "delete": {
            "description": "Delete a draft",
            "params": ["draft_id"]
          }
        },
        "thread": {
          "getAll": {
            "description": "List email threads",
            "params": ["query?", "received_after?", "received_before?", "return_all?"]
          },
          "get": {
            "description": "Get a specific thread",
            "params": ["thread_id"]
          },
          "reply": {
            "description": "Reply to a thread",
            "params": ["thread_id", "message", "cc?", "bcc?"]
          },
          "addLabels": {
            "description": "Add labels to a thread",
            "params": ["thread_id", "label_ids"]
          },
          "removeLabels": {
            "description": "Remove labels from a thread",
            "params": ["thread_id", "label_ids"]
          }
        }
      },
      "auth": {
        "type": "oauth2_token",
        "param": "access_token",
        "description": "Pass OAuth2 access token in request body"
      }
    }
  }
}
