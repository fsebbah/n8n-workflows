    {
      "id": "single-label-classify",
      "name": "Single Label Classification",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.8,
      "position": [
        940,
        300
      ],
      "parameters": {
        "resource": "chat",
        "operation": "message",
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "content": "You are a precise text classifier. Classify the given text into exactly ONE of the provided categories. Return a JSON object with 'category' (the chosen category) and 'confidence' (a number between 0 and 1). Only respond with valid JSON, no explanation.",
              "role": "system"
            },
            {
              "content": "={{ 'Classify the following text into one of these categories: ' + $json.body.categories.join(', ') + '\\n\\nText to classify:\\n' + $json.body.text }}",
              "role": "user"
            }
          ]
        },
        "options": {
          "temperature": 0.1,
          "responseFormat": "json_object"
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "openai-credentials",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "multi-label-classify",
      "name": "Multi Label Classification",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.8,
      "position": [
        940,
        100
      ],
      "parameters": {
        "resource": "chat",
        "operation": "message",
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "content": "You are a precise text classifier. Classify the given text into ALL applicable categories from the provided list. Return a JSON object with 'categories' (array of objects, each with 'category' and 'confidence' between 0 and 1). Only include categories with confidence > 0.3. Only respond with valid JSON, no explanation.",
              "role": "system"
            },
            {
              "content": "={{ 'Classify the following text into applicable categories from this list: ' + $json.body.categories.join(', ') + '\\n\\nText to classify:\\n' + $json.body.text }}",
              "role": "user"
            }
          ]
        },
        "options": {
          "temperature": 0.1,
          "responseFormat": "json_object"
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "openai-credentials",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "format-single",
      "name": "Format Single Label",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1160,
        300
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ (() => { const webhookData = $('Webhook').first().json; const startTime = new Date(webhookData.headers?.['x-request-start'] || Date.now()).getTime(); try { const result = JSON.parse($json.message.content); return { \"success\": true, \"data\": { \"classification\": { \"category\": result.category, \"confidence\": result.confidence }, \"mode\": \"single_label\", \"input_categories\": webhookData.body.categories, \"text_length\": webhookData.body.text.length }, \"meta\": { \"provider\": \"openai\", \"model\": \"gpt-4o-mini\", \"execution_mode\": webhookData.body.execution_mode || \"online\" }, \"_trace\": { \"service_response\": $json.message?.content || null, \"model\": \"gpt-4o-mini\", \"tokens\": { \"input\": null, \"output\": null }, \"latency_ms\": Date.now() - startTime } }; } catch(e) { return { \"success\": false, \"error\": { \"code\": 500, \"message\": \"Failed to parse classification result\", \"status\": \"PARSE_ERROR\" }, \"_trace\": { \"service_response\": $json.message?.content || null, \"model\": \"gpt-4o-mini\", \"tokens\": { \"input\": null, \"output\": null }, \"latency_ms\": Date.now() - startTime } }; } })() }}"
      }
    },
    {
      "id": "format-multi",
      "name": "Format Multi Label",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1160,
        100
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ (() => { const webhookData = $('Webhook').first().json; const startTime = new Date(webhookData.headers?.['x-request-start'] || Date.now()).getTime(); try { const result = JSON.parse($json.message.content); return { \"success\": true, \"data\": { \"classifications\": result.categories || [], \"mode\": \"multi_label\", \"input_categories\": webhookData.body.categories, \"text_length\": webhookData.body.text.length }, \"meta\": { \"provider\": \"openai\", \"model\": \"gpt-4o-mini\", \"execution_mode\": webhookData.body.execution_mode || \"online\" }, \"_trace\": { \"service_response\": $json.message?.content || null, \"model\": \"gpt-4o-mini\", \"tokens\": { \"input\": null, \"output\": null }, \"latency_ms\": Date.now() - startTime } }; } catch(e) { return { \"success\": false, \"error\": { \"code\": 500, \"message\": \"Failed to parse classification result\", \"status\": \"PARSE_ERROR\" }, \"_trace\": { \"service_response\": $json.message?.content || null, \"model\": \"gpt-4o-mini\", \"tokens\": { \"input\": null, \"output\": null }, \"latency_ms\": Date.now() - startTime } }; } })() }}"
      }
    },
