    {
      "name": "Create Phone Item",
      "type": "n8n-nodes-base.functionItem",
      "position": [
        640,
        510
      ],
      "parameters": {
        "functionCode": "item.phone = \"+34605281220\";\nreturn item;"
      },
      "typeVersion": 1,
      "id": "e10a7e80-6a96-47df-a8cf-07ff6c5dbe88",
      "notes": "This functionItem node performs automated tasks as part of the workflow."
