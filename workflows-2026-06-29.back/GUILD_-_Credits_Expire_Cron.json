{
  "name": "GUILD - Credits Expire Cron",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_API_URL }}/api/ecommerce/admin/guilds/cron/expire-batches",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Token",
              "value": "={{ $env.BACKEND_SERVICE_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-expire",
      "name": "Call Expire Endpoint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-has-expired",
              "leftValue": "={{ $json.expired_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-expired",
      "name": "Has Expired?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "log-expired",
              "name": "log",
              "value": "={{ 'Expired ' + $json.expired_count + ' credit batches, ' + $json.total_credits_lost + ' credits lost' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-expired",
      "name": "Log Expired",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [920, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "log-none",
              "name": "log",
              "value": "No credit batches expired this hour",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-none",
      "name": "Log None",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [920, 400]
    }
  ],
  "connections": {
    "Every Hour": {
      "main": [
        [
          {
            "node": "Call Expire Endpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Expire Endpoint": {
      "main": [
        [
          {
            "node": "Has Expired?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Expired?": {
      "main": [
        [
          {
            "node": "Log Expired",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log None",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "guild-credits"
    },
    {
      "name": "cron"
    }
  ]
}
