      "id": "check-exists",
      "name": "Job Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "parse-job",
      "name": "Parse Job Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ],
      "parameters": {
        "jsCode": "const jobStr = $input.first().json;\ntry {\n  const job = typeof jobStr === 'string' ? JSON.parse(jobStr) : jobStr;\n  return { json: job };\n} catch (e) {\n  return { json: { error: 'Invalid job data' } };\n}"
      }
    },
    {
      "id": "respond-success",
      "name": "Respond Job Status",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1120,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    },
    {
      "id": "respond-not-found",
      "name": "Respond Not Found",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        900,
        400
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: 'Job not found', job_id: $('Webhook').first().json.params.job_id } }}",
        "options": {
          "responseCode": 404
        }
      }
    }
  ],
