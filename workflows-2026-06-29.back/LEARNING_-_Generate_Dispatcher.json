  "name": "LEARNING - Generate Dispatcher",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "learning-generate",
      "parameters": {
        "httpMethod": "POST",
        "path": "learning-generate",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "validate-input",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "jsCode": "// Handle both direct body and nested body.body (plugin compatibility)\nconst rawBody = $input.first().json.body || $input.first().json;\nconst body = rawBody.body || rawBody;\n\n// Determine job type\nconst jobType = body.type || (body.lesson_id ? 'quiz' : 'course');\n\n// Validate based on type - user_id and guild_id always required\nlet required = ['prompt', 'guild_id', 'user_id', 'anthropic_api_key'];\nif (jobType === 'quiz') {\n  required.push('lesson_id');\n  if (!body.topic && !body.content) {\n    return {\n      json: {\n        valid: false,\n        error: {\n          code: 400,\n          message: 'Missing required parameters: topic or content',\n          status: 'BAD_REQUEST'\n        }\n      }\n    };\n  }\n} else {\n  required.push('topic', 'instructor_id');\n}\n\nconst missing = required.filter(field => !body[field]);\n\nif (missing.length > 0) {\n  return {\n    json: {\n      valid: false,\n      error: {\n        code: 400,\n        message: `Missing required parameters: ${missing.join(', ')}`,\n        status: 'BAD_REQUEST'\n      }\n    }\n  };\n}\n\n// Generate unique job_id with type prefix\nconst job_id = `${jobType}_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;\n\nreturn {\n  json: {\n    valid: true,\n    job_id: job_id,\n    type: jobType,\n    body: body\n  }\n};"
      }
    },
    {
      "id": "check-valid",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "store-job-redis",
      "name": "Store Job in Redis",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        900,
        200
      ],
      "parameters": {
        "operation": "set",
        "key": "=job:learning:{{ $json.job_id }}",
        "value": "={{ JSON.stringify({ job_id: $json.job_id, type: $json.type, status: 'pending', created_at: new Date().toISOString(), body: $json.body }) }}",
        "expire": true,
        "ttl": 3600
      },
      "credentials": {
        "redis": {
          "id": "2idv3VKZ91q5gOnz",
          "name": "Redis account"
        }
      }
    },
    {
      "id": "push-to-queue",
      "name": "Push to Queue",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1120,
        200
      ],
      "parameters": {
        "operation": "push",
        "list": "queue:learning",
        "messageData": "={{ $('Validate Input').first().json.job_id }}",
        "tail": true
      },
      "credentials": {
        "redis": {
          "id": "2idv3VKZ91q5gOnz",
          "name": "Redis account"
        }
      }
    },
    {
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1340,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, job_id: $('Validate Input').first().json.job_id, type: $('Validate Input').first().json.type, status: 'pending', message: $('Validate Input').first().json.type === 'quiz' ? 'Génération du quiz en cours...' : 'Génération du cours en cours...' } }}",
        "options": {}
      }
    },
    {
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        900,
        400
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, error: $('Validate Input').first().json.error } }}",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],
