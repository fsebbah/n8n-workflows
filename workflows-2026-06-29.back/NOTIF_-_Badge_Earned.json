  "nodes": [
    {
      "parameters": {
        "content": "## NOTIF - Badge Earned\n\n**Trigger:** Cron every 10 seconds\n\n**Source:** RFC-030 (Option B)\n\n**Description:**\nPolls Redis Stream for badge:earned events\nand publishes notifications to Discord.\n\n**Input Stream:** `xp:events:stream`\n**Output Stream:** `notifications:stream`",
        "height": 280,
        "width": 320,
        "color": 5
      },
      "id": "notif-badge-0000",
      "name": "Documentation",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -208,
        64
      ]
    },
    {
      "parameters": {
        "operation": "xRead"
      },
      "id": "notif-badge-0001",
      "name": "Redis xRead",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        288,
        304
      ],
      "credentials": {
        "redis": {
          "id": "2idv3VKZ91q5gOnz",
          "name": "Redis account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// FILTER BADGE EARNED EVENTS\n// ============================================\n\nconst items = $input.all();\nconst badgeEvents = [];\n\nfor (const item of items) {\n  const data = item.json;\n  \n  let event = data.event || data;\n  if (typeof event === 'string') {\n    try {\n      event = JSON.parse(event);\n    } catch (e) {\n      continue;\n    }\n  }\n  \n  if (event.event === 'badge:earned' || event.type === 'badge:earned') {\n    badgeEvents.push({\n      json: {\n        event_id: data.id || `badge_${Date.now()}`,\n        event_type: 'badge:earned',\n        guild_id: event.guild_id,\n        user_id: event.data?.user_id || event.user_id,\n        discord_id: event.data?.discord_id || event.discord_id,\n        badge_id: event.data?.badge_id || event.badge_id,\n        badge_name: event.data?.badge_name || event.badge_name || 'Badge',\n        badge_icon: event.data?.badge_icon || event.badge_icon || '🏅',\n        badge_description: event.data?.badge_description || '',\n        timestamp: event.timestamp || new Date().toISOString()\n      }\n    });\n  }\n}\n\nreturn badgeEvents.length > 0 ? badgeEvents : [];"
      },
      "id": "notif-badge-0002",
      "name": "Filter Badge Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-events",
              "leftValue": "={{ $json.event_type }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "notif-badge-0003",
      "name": "Has Events?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// PREPARE BADGE EMBED\n// ============================================\n\nconst data = $input.first().json;\n\nconst embed = {\n  title: `${data.badge_icon} Nouveau Badge !`,\n  description: `Tu as obtenu le badge **${data.badge_name}** !`,\n  color: 0xFFD700,\n  fields: [\n    {\n      name: 'Badge',\n      value: `${data.badge_icon} ${data.badge_name}`,\n      inline: true\n    }\n  ],\n  footer: { text: 'Continue a collectionner !' },\n  timestamp: data.timestamp\n};\n\nif (data.badge_description) {\n  embed.fields.push({\n    name: 'Description',\n    value: data.badge_description,\n    inline: false\n  });\n}\n\nreturn {\n  type: 'dm',\n  guild_id: data.guild_id,\n  discord_id: data.discord_id,\n  content: `<@${data.discord_id}>`,\n  embed: embed,\n  notification_type: 'badge_earned',\n  source: 'n8n:NOTIF-Badge-Earned',\n  event_id: data.event_id,\n  timestamp: new Date().toISOString()\n};"
      },
      "id": "notif-badge-0004",
      "name": "Prepare Notification Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        208
      ]
    },
    {
      "parameters": {
        "operation": "xAdd"
      },
      "id": "notif-badge-0005",
      "name": "Publish to notifications:stream",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1168,
        208
      ],
      "credentials": {
        "redis": {
          "id": "notifications-redis",
          "name": "Redis Notifications (DB 5)"
        }
      }
    },
    {
      "parameters": {},
