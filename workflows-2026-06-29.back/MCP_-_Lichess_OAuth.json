      {
        "parameters": {
          "jsCode": "const flowDataStr = $input.first().json.flowData;\nconst code = $('Validate Params').first().json.code;\nconst state = $('Validate Params').first().json.state;\n\nlet flowData;\ntry {\n  flowData = JSON.parse(flowDataStr);\n} catch (e) {\n  return [{\n    json: {\n      success: false,\n      error: 'parse_error'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    code: code,\n    state: state,\n    user_id: flowData.user_id,\n    code_verifier: flowData.code_verifier,\n    client_id: flowData.client_id || 'chess-discord-bot',\n    redirect_uri: flowData.redirect_uri || 'https://lichess.azy.solutions/webhook/lichess-oauth-callback',\n    provider: flowData.provider || 'lichess'\n  }\n}];"
