    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst query = input.query || {};\n\nconst code = query.code;\nconst state = query.state;\n\nif (!code || !state) {\n  return [{\n    json: {\n      valid: false,\n      error: 'params_missing'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    code,\n    state\n  }\n}];"
      },
