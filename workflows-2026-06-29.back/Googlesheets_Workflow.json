{
  "updatedAt": "2025-12-03T18:57:46.225Z",
  "createdAt": "2025-12-03T18:57:46.225Z",
  "id": "zUg4bKzlhtvM4jdn",
  "name": "Googlesheets Workflow",
  "description": "Automated workflow: Googlesheets Workflow. This workflow processes data and performs automated tasks.",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "trigger-5cd75600",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        100,
        100
      ],
      "parameters": {}
    },
    {
      "name": "Get Content Ideas",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        200,
        300
      ],
      "parameters": {
        "range": "Sheet1!A:C",
        "sheetId": "YOUR_GOOGLE_SHEET_ID"
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": null,
          "name": "YOUR_GOOGLE_SHEETS_CREDENTIALS"
        }
      },
      "typeVersion": 1,
      "id": "cd912cf7-67ca-4f45-89d9-82a3ea3a3487",
      "notes": "This googleSheets node performs automated tasks as part of the workflow."
    },
    {
      "name": "Generate Post with OpenAI",
      "type": "n8n-nodes-base.openAi",
      "position": [
        500,
        300
      ],
      "parameters": {
        "model": "gpt-4",
        "prompt": "Create a social media post for {{$node[\"Get Content Ideas\"].json[\"Platform\"]}} based on this idea: {{$node[\"Get Content Ideas\"].json[\"Idea\"]}}. Keep it engaging and concise."
      },
      "credentials": {
        "openAIApi": {
          "id": null,
          "name": "YOUR_OPENAI_CREDENTIALS"
        }
      },
      "typeVersion": 1,
      "id": "9e632dde-3e1f-4551-8689-78c865affaa8",
      "notes": "This openAi node performs automated tasks as part of the workflow."
    },
    {
      "name": "Check Platform",
      "type": "n8n-nodes-base.if",
      "position": [
        800,
        300
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "{{$node[\"Get Content Ideas\"].json[\"Platform\"]}}",
              "value2": "Twitter",
              "operation": "equal"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "be27defe-cc38-45d3-9f20-9b725c10d37d",
      "notes": "This if node performs automated tasks as part of the workflow."
    },
    {
      "name": "Post to Twitter",
      "type": "n8n-nodes-base.twitter",
      "position": [
        1000,
        200
      ],
      "parameters": {
        "text": "{{$node[\"Generate Post with OpenAI\"].json[\"text\"]}}"
      },
      "credentials": {
        "twitterOAuth1Api": {
          "id": null,
          "name": "YOUR_TWITTER_CREDENTIALS"
        }
      },
      "typeVersion": 1,
      "id": "d269f30f-ae22-47b5-8445-27d2f9fc06d5",
      "notes": "This twitter node performs automated tasks as part of the workflow."
    },
    {
      "name": "Update Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        1200,
        300
      ],
      "parameters": {
        "range": "Sheet1!D:F",
        "values": "Posted,{{$node[\"Generate Post with OpenAI\"].json[\"text\"]}},{{Date.now()}}",
        "sheetId": "YOUR_GOOGLE_SHEET_ID",
        "updateOperation": "append"
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": null,
          "name": "YOUR_GOOGLE_SHEETS_CREDENTIALS"
        }
      },
      "typeVersion": 1,
      "id": "17ca6222-4448-4936-9f4c-e0b22ba996eb",
      "notes": "This googleSheets node performs automated tasks as part of the workflow."
    },
    {
      "id": "error-ccfac0b3",
      "name": "Error Handler",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1000,
        400
      ],
      "parameters": {
        "message": "Workflow execution error",
        "options": {}
      }
    }
  ],
