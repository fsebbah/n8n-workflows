          "id": "U7trUA4hFkSWHagH",
          "name": "Clockify account"
        }
      },
      "typeVersion": 1,
      "notes": "This clockify node performs automated tasks as part of the workflow."
    },
    {
      "id": "1f723b4b-30c7-45c9-b3b5-b55211597a93",
      "name": "Notion Trigger on new client",
