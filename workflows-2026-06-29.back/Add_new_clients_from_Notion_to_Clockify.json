  "isArchived": false,
  "nodes": [
    {
      "id": "f58df180-644e-4e59-a32d-b6b316b8ff97",
      "name": "Add client to Clockify",
      "type": "n8n-nodes-base.clockify",
      "position": [
        240,
        -320
      ],
      "parameters": {
        "name": "={{ $json.Name }}",
