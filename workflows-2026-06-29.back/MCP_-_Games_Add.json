    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_API_URL || 'https://api.azy.solutions' }}/api/n8n/games/add",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-API-Key",
              "value": "={{ $env.N8N_API_KEY }}"
            },
            {
              "name": "X-Tenant-ID",
              "value": "={{ $json.tenant_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_id: $json.user_id, game: $json.game }) }}",
        "options": {
