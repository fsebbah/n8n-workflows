{
  "version": "1.0",
  "description": "Schema for MCP Tools - Phase 1",
  "tools": {
    "video-transcription": {
      "name": "Video Transcription",
      "endpoint": "/webhook/video-transcription",
      "method": "POST",
      "description": "Transcribe audio/video files using OpenAI Whisper",
      "parameters": {
        "required": {
          "url": {
            "type": "string",
            "description": "URL of the audio/video file to transcribe"
          }
        },
        "optional": {
          "language": {
            "type": "string",
            "description": "Language code (e.g., 'en', 'fr')",
            "default": "auto-detect"
          },
          "execution_mode": {
            "type": "string",
            "enum": ["online", "offline"],
            "default": "online"
          }
        }
      }
    },
    "text-to-speech": {
      "name": "Text to Speech",
      "endpoint": "/webhook/text-to-speech",
      "method": "POST",
      "description": "Convert text to speech using OpenAI TTS",
      "parameters": {
        "required": {
          "text": {
            "type": "string",
            "description": "Text to convert to speech"
          }
        },
        "optional": {
          "voice": {
            "type": "string",
            "enum": ["alloy", "echo", "fable", "onyx", "nova", "shimmer"],
            "default": "alloy"
          },
          "model": {
            "type": "string",
            "enum": ["tts-1", "tts-1-hd"],
            "default": "tts-1"
          },
          "speed": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 4.0,
            "default": 1.0
          },
          "execution_mode": {
            "type": "string",
            "enum": ["online", "offline"],
            "default": "online"
          }
        }
      }
    },
    "linkedin": {
      "name": "LinkedIn",
      "endpoint": "/webhook/linkedin",
      "method": "POST",
      "description": "Interact with LinkedIn profiles and posts",
      "parameters": {
        "required": {
          "action": {
            "type": "string",
            "enum": ["get_profile", "search"],
            "description": "Action to perform"
          }
        },
        "optional": {
          "profile_url": {
            "type": "string",
            "description": "LinkedIn profile URL (for get_profile action)"
          },
          "query": {
            "type": "string",
            "description": "Search query (for search action)"
          },
          "execution_mode": {
            "type": "string",
            "enum": ["online", "offline"],
            "default": "online"
          }
        }
      }
    },
    "pdf-extractor": {
      "name": "PDF Extractor",
      "endpoint": "/webhook/pdf-extractor",
      "method": "POST",
      "description": "Extract text content from PDF files",
      "parameters": {
        "required": {
          "url": {
            "type": "string",
            "description": "URL of the PDF file to extract"
          }
        },
        "optional": {
          "pages": {
            "type": "string",
            "description": "Page range to extract (e.g., '1-5', 'all')",
            "default": "all"
          },
          "execution_mode": {
            "type": "string",
            "enum": ["online", "offline"],
            "default": "online"
          }
        }
      }
    },
    "entity-extractor": {
      "name": "Entity Extractor",
      "endpoint": "/webhook/entity-extractor",
      "method": "POST",
      "description": "Extract named entities from text using OpenAI",
      "parameters": {
        "required": {
          "text": {
            "type": "string",
            "description": "Text to analyze for entities"
          }
        },
        "optional": {
          "entity_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["PERSON", "ORGANIZATION", "LOCATION", "DATE", "MONEY", "PRODUCT", "EVENT"]
            },
            "description": "Types of entities to extract",
            "default": ["PERSON", "ORGANIZATION", "LOCATION", "DATE"]
          },
          "execution_mode": {
            "type": "string",
            "enum": ["online", "offline"],
            "default": "online"
          }
        }
      }
    },
    "summarizer": {
      "name": "Summarizer",
      "endpoint": "/webhook/summarizer",
      "method": "POST",
      "description": "Summarize text using Anthropic Claude",
      "parameters": {
        "required": {
          "text": {
            "type": "string",
            "description": "Text to summarize"
          }
        },
        "optional": {
          "style": {
            "type": "string",
            "enum": ["concise", "detailed", "bullet-points"],
            "default": "concise"
          },
          "max_length": {
            "type": "integer",
            "description": "Maximum length of summary in words",
            "default": 200
          },
          "language": {
            "type": "string",
            "description": "Output language",
            "default": "same as input"
          },
          "execution_mode": {
            "type": "string",
            "enum": ["online", "offline"],
            "default": "online"
          }
        }
      }
    },
    "text-generator": {
      "name": "Text Generator",
      "endpoint": "/webhook/text-generator",
      "method": "POST",
      "description": "Generate text using OpenAI GPT-4o",
      "parameters": {
        "required": {
          "prompt": {
            "type": "string",
            "description": "Prompt for text generation"
          }
        },
        "optional": {
          "model": {
            "type": "string",
            "enum": ["gpt-4o", "gpt-4o-mini", "gpt-4-turbo"],
            "default": "gpt-4o"
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "default": 0.7
          },
          "max_tokens": {
            "type": "integer",
            "default": 1000
          },
          "system_prompt": {
            "type": "string",
            "description": "System prompt to set context"
          },
          "execution_mode": {
            "type": "string",
            "enum": ["online", "offline"],
            "default": "online"
          }
        }
      }
    },
    "code-generator": {
      "name": "Code Generator",
      "endpoint": "/webhook/code-generator",
      "method": "POST",
      "description": "Generate code using OpenAI GPT-4o",
      "parameters": {
        "required": {
          "prompt": {
            "type": "string",
            "description": "Description of the code to generate"
          }
        },
        "optional": {
          "language": {
            "type": "string",
            "description": "Programming language",
            "default": "python"
          },
          "framework": {
            "type": "string",
            "description": "Framework or library context"
          },
          "context": {
            "type": "string",
            "description": "Additional context or existing code"
          },
          "execution_mode": {
            "type": "string",
            "enum": ["online", "offline"],
            "default": "online"
          }
        }
      }
    },
    "youtube-searcher": {
      "name": "YouTube Searcher",
      "endpoint": "/webhook/youtube-searcher",
      "method": "POST",
      "description": "Search YouTube using the Data API v3",
      "parameters": {
        "required": {
          "query": {
            "type": "string",
            "description": "Search query"
          }
        },
        "optional": {
          "type": {
            "type": "string",
            "enum": ["video", "channel", "playlist"],
            "default": "video"
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          },
          "order": {
            "type": "string",
            "enum": ["relevance", "date", "rating", "viewCount"],
            "default": "relevance"
          },
          "execution_mode": {
            "type": "string",
            "enum": ["online", "offline"],
            "default": "online"
          }
        }
      }
    },
    "google-searcher": {
      "name": "Google Searcher",
      "endpoint": "/webhook/google-searcher",
      "method": "POST",
      "description": "Search Google using SerpAPI",
      "parameters": {
        "required": {
          "query": {
            "type": "string",
            "description": "Search query"
          }
        },
        "optional": {
          "num_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10
          },
          "language": {
            "type": "string",
            "description": "Language code (e.g., 'en', 'fr')",
            "default": "en"
          },
          "country": {
            "type": "string",
            "description": "Country code (e.g., 'us', 'fr')",
            "default": "us"
          },
          "execution_mode": {
            "type": "string",
            "enum": ["online", "offline"],
            "default": "online"
          }
        }
      }
    },
    "vector-store": {
      "name": "Vector Store",
      "endpoint": "/webhook/vector-store",
      "method": "POST",
      "description": "Store, search, and manage vectors in Qdrant",
      "parameters": {
        "required": {
          "action": {
            "type": "string",
            "enum": ["store", "search", "delete"],
            "description": "Action to perform"
          }
        },
        "optional": {
          "collection": {
            "type": "string",
            "description": "Collection name",
            "default": "default"
          },
          "text": {
            "type": "string",
            "description": "Text to embed and store (for store action)"
          },
          "query": {
            "type": "string",
            "description": "Query text for semantic search (for search action)"
          },
          "id": {
            "type": "string",
            "description": "Vector ID (for delete action)"
          },
          "top_k": {
            "type": "integer",
            "description": "Number of results to return (for search)",
            "default": 5
          },
          "metadata": {
            "type": "object",
            "description": "Additional metadata to store with vector"
          },
          "execution_mode": {
            "type": "string",
            "enum": ["online", "offline"],
            "default": "online"
          }
        }
      }
    },
    "image-ocr": {
      "name": "Image OCR",
      "endpoint": "/webhook/image-ocr",
      "method": "POST",
      "description": "Extract text from images using Mistral Pixtral vision model",
      "parameters": {
        "required": {
          "image_url": {
            "type": "string",
            "description": "URL of the image to analyze"
          }
        },
        "optional": {
          "language": {
            "type": "string",
            "description": "Expected text language",
            "default": "auto-detect"
          },
          "output_format": {
            "type": "string",
            "enum": ["text", "structured"],
            "default": "text"
          },
          "execution_mode": {
            "type": "string",
            "enum": ["online", "offline"],
            "default": "online"
          }
        }
      }
    },
    "llm-summarizer": {
      "name": "LLM Summarizer",
      "endpoint": "/webhook/llm-summarizer",
      "method": "POST",
      "description": "Summarize text with multi-provider support (Anthropic, OpenAI, Mistral)",
      "parameters": {
        "required": {
          "text": {
            "type": "string",
            "description": "Text to summarize"
          }
        },
        "optional": {
          "provider": {
            "type": "string",
            "enum": ["anthropic", "openai", "mistral"],
            "default": "anthropic"
          },
          "format": {
            "type": "string",
            "enum": ["bullet-points", "paragraph", "executive-summary"],
            "default": "paragraph"
          },
          "max_length": {
            "type": "integer",
            "description": "Maximum summary length in words"
          },
          "language": {
            "type": "string",
            "description": "Output language",
            "default": "same as input"
          },
          "execution_mode": {
            "type": "string",
            "enum": ["online", "offline"],
            "default": "online"
          }
        }
      }
    },
    "text-classifier": {
      "name": "Text Classifier",
      "endpoint": "/webhook/text-classifier",
      "method": "POST",
      "description": "Classify text into categories using OpenAI GPT-4o-mini",
      "parameters": {
        "required": {
          "text": {
            "type": "string",
            "description": "Text to classify"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of category labels to classify into"
          }
        },
        "optional": {
          "multi_label": {
            "type": "boolean",
            "description": "Allow multiple categories (default: single label)",
            "default": false
          },
          "execution_mode": {
            "type": "string",
            "enum": ["online", "offline"],
            "default": "online"
          }
        }
      }
    }
  }
}
