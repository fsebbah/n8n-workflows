# =============================================================================
# n8n Docker Configuration
# =============================================================================
# Copier ce fichier en .env et configurer les valeurs
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=databases.local
DB_POSTGRESDB_PORT=5435
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=n8npass

# -----------------------------------------------------------------------------
# n8n Encryption Key (CRITIQUE - doit être identique sur tous les serveurs)
# -----------------------------------------------------------------------------
# Cette clé est utilisée pour chiffrer/déchiffrer les credentials
# Si vous migrez depuis une installation existante, utilisez la clé de ~/.n8n/config
N8N_ENCRYPTION_KEY=your-encryption-key-from-config

# -----------------------------------------------------------------------------
# n8n Server Configuration
# -----------------------------------------------------------------------------
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://pi6.local:5678/

# -----------------------------------------------------------------------------
# n8n Features
# -----------------------------------------------------------------------------
# Task runners (performance)
N8N_RUNNERS_ENABLED=true

# Accès aux env vars dans les nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Workflow history (désactivé pour performance)
N8N_WORKFLOW_HISTORY_ENABLED=false

# Sécurité
N8N_SECURE_COOKIE=false
N8N_DISABLE_UI=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false

# Git
N8N_GIT_NODE_DISABLE_BARE_REPOS=true

# Permissions
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# -----------------------------------------------------------------------------
# Timezone
# -----------------------------------------------------------------------------
GENERIC_TIMEZONE=Europe/Paris
TZ=Europe/Paris

# -----------------------------------------------------------------------------
# Executions
# -----------------------------------------------------------------------------
EXECUTIONS_MODE=regular
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# -----------------------------------------------------------------------------
# API Keys (utilisés par les workflows)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
MISTRAL_API_KEY=xxx

# -----------------------------------------------------------------------------
# Torah API
# -----------------------------------------------------------------------------
API_URL=http://pi6.local:3031
TORAH_API_URL=http://pi6.local:3031

# -----------------------------------------------------------------------------
# Discord Bot
# -----------------------------------------------------------------------------
DISCORD_TOKEN=Bot xxx
