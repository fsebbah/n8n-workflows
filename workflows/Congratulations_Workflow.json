      "notes": "This noOp node performs automated tasks as part of the workflow."
    },
    {
      "name": "Congratulations Messages",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        1000,
        550
      ],
      "parameters": {
        "range": "Congratulations Messages!A:B",
        "options": {},
        "sheetId": "",
        "authentication": "{{ $credentials.oAuth2 }}"
      },
      "typeVersion": 1,
      "id": "92c7abc7-05b5-472b-a6fb-ed8ae225eb40",
      "notes": "This googleSheets node performs automated tasks as part of the workflow."
    },
    {
      "name": "Merge Data",
      "type": "n8n-nodes-base.merge",
      "position": [
        1200,
        400
      ],
      "parameters": {
        "mode": "mergeByKey",
        "propertyName1": "Event Name",
        "propertyName2": "Event Name"
      },
      "typeVersion": 1,
      "id": "f92e4639-26c0-44ee-829f-1310a9a61d98",
      "notes": "This merge node performs automated tasks as part of the workflow."
    },
    {
      "name": "Personalize Message",
      "type": "n8n-nodes-base.function",
      "position": [
        1400,
        400
      ],
      "parameters": {
        "functionCode": "const newItems = [];\n\nfor (let i=0;i<items.length;i++) {\n  wishes_array = items[i].json.Congratulations.split(',');\n  greeting = wishes_array.shift();\n  \n  new_wish = greeting + ' ' + items[i].json['First Name'] + ',' + wishes_array.join(',');\n  newItems.push({json: {Wishes: new_wish, \"Phone Number\": items[i].json['Phone Number']}});\n}\n\nreturn newItems;"
      },
      "typeVersion": 1,
      "id": "f1db6ed4-d97f-4434-bf79-52898129428b",
      "notes": "This function node performs automated tasks as part of the workflow."
    },
    {
      "name": "Send SMS",
      "type": "n8n-nodes-base.twilio",
      "position": [
        1600,
        400
      ],
      "parameters": {
        "to": "={{$node[\"Personalize Message\"].json[\"Phone Number\"]}}",
        "from": "",
        "message": "={{$node[\"Personalize Message\"].json[\"Wishes\"]}}"
      },
      "credentials": {
        "twilioApi": {
          "id": null,
          "name": "Twilio Programmable SMS"
        }
      },
      "typeVersion": 1,
      "id": "4df1b6aa-d4bf-42d2-8ff9-d8c7dedce4fe",
      "notes": "This twilio node performs automated tasks as part of the workflow."
    },
    {
      "id": "error-c4ffda16",
      "name": "Error Handler",
