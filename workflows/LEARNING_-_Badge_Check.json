    },
    {
      "id": "collect-results",
      "name": "Collect Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2020,
        100
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst checkData = $('Check Badge Criteria').first().json;\n\nconst awardedBadges = items.map(item => ({\n  badge_id: item.json.badge_id,\n  badge_name: item.json.badge_name,\n  awarded_at: item.json.awarded_at\n})).filter(b => b.badge_id);\n\nreturn {\n  json: {\n    success: true,\n    data: {\n      learner_discord_id: checkData.learner_discord_id,\n      badges_awarded: awardedBadges,\n      badges_awarded_count: awardedBadges.length,\n      progress_summary: checkData.progress_summary\n    },\n    meta: {\n      workflow: 'learning-badge-check',\n      timestamp: new Date().toISOString()\n    }\n  }\n};"
      }
    },
