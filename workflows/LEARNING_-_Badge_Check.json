              "value": "={{ $json.guild_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"learner_discord_id\": \"{{ $json.learner_discord_id }}\",\n  \"badge_id\": \"{{ $json.badge_id }}\",\n  \"reason\": \"{{ $json.reason }}\"\n}",
        "options": {
