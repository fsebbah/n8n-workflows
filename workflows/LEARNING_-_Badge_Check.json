    {
      "id": "check-badges",
      "name": "Check Badge Criteria",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        200
      ],
      "parameters": {
        "jsCode": "const webhookData = $('Webhook').first().json;\nconst progress = $input.first().json;\n\n// Badge definitions with criteria\nconst BADGES = {\n  first_lesson: {\n    id: 'first_lesson',\n    name: 'Premier Pas',\n    check: (p) => p.courses?.some(c => c.completed_lessons >= 1)\n  },\n  first_course: {\n    id: 'first_course', \n    name: 'Diplômé',\n    check: (p) => p.courses?.some(c => c.enrollment_status === 'completed')\n  },\n  week_streak: {\n    id: 'week_streak',\n    name: 'Régulier',\n    check: (p) => (p.streak_days || 0) >= 7\n  },\n  month_streak: {\n    id: 'month_streak',\n    name: 'Assidu',\n    check: (p) => (p.streak_days || 0) >= 30\n  },\n  quiz_master: {\n    id: 'quiz_master',\n    name: 'Expert',\n    check: (p) => (p.quiz_stats?.passed || 0) >= 10 && (p.quiz_stats?.average_score || 0) >= 90\n  },\n  level_5: {\n    id: 'level_5',\n    name: 'Sous-Chef',\n    check: (p) => (p.level || 1) >= 5\n  },\n  level_10: {\n    id: 'level_10',\n    name: 'Grand Maître',\n    check: (p) => (p.level || 1) >= 10\n  }\n};\n\n// Get current badges (from API response or empty)\nconst currentBadges = progress.badges?.map(b => b.badge_id) || [];\n\n// Check which new badges should be awarded\nconst newBadges = [];\nfor (const [badgeId, badge] of Object.entries(BADGES)) {\n  if (!currentBadges.includes(badgeId) && badge.check(progress)) {\n    newBadges.push({\n      badge_id: badgeId,\n      name: badge.name,\n      reason: `Critères remplis automatiquement`\n    });\n  }\n}\n\nreturn {\n  json: {\n    learner_discord_id: webhookData.body.learner_discord_id,\n    guild_id: webhookData.body.guild_id,\n    current_badges: currentBadges,\n    new_badges: newBadges,\n    progress_summary: {\n      level: progress.level || 1,\n      xp_total: progress.xp_total || 0,\n      courses_count: progress.courses?.length || 0,\n      streak_days: progress.streak_days || 0\n    }\n  }\n};"
      }
    },
