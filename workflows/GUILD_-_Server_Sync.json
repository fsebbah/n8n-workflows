{
  "name": "GUILD - Server Sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "server-sync",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "server-sync"
    },
    {
      "parameters": {
        "jsCode": "// Extract and validate data from webhook body\nconst body = $input.first().json.body;\n\n// Required fields\nif (!body.guild_id) {\n  throw new Error('guild_id is required');\n}\nif (!body.bot_id) {\n  throw new Error('bot_id is required');\n}\n\nreturn {\n  guild_id: body.guild_id,\n  bot_id: body.bot_id,\n  guild_name: body.guild_name || null,\n  guild_icon: body.guild_icon || null,\n  guild_description: body.guild_description || null,\n  member_count: body.member_count || null,\n  channel_count: body.channel_count || null,\n  bot_count: body.bot_count || null,\n  sync_source: body.sync_source || 'plugin',\n  synced_by: body.synced_by || 'unknown'\n};"
      },
      "id": "validate-data",
      "name": "Validate Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_API_URL }}/api/discord/webhook/server-sync",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"guild_id\": \"{{ $json.guild_id }}\",\n  \"bot_id\": \"{{ $json.bot_id }}\",\n  \"guild_name\": {{ $json.guild_name ? '\"' + $json.guild_name + '\"' : 'null' }},\n  \"guild_icon\": {{ $json.guild_icon ? '\"' + $json.guild_icon + '\"' : 'null' }},\n  \"guild_description\": {{ $json.guild_description ? '\"' + $json.guild_description + '\"' : 'null' }},\n  \"member_count\": {{ $json.member_count || 'null' }},\n  \"channel_count\": {{ $json.channel_count || 'null' }},\n  \"bot_count\": {{ $json.bot_count || 'null' }},\n  \"sync_source\": \"{{ $json.sync_source }}\",\n  \"synced_by\": \"{{ $json.synced_by }}\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "call-backend",
      "name": "Sync to Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "backend-service-token",
          "name": "Backend Service Token"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: $json.ok || $json.synced, guild_id: $('Validate Data').item.json.guild_id, synced: true }) }}",
        "options": {}
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [920, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Validate Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Data": {
      "main": [
        [
          {
            "node": "Sync to Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sync to Backend": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "guild"
    },
    {
      "name": "discord"
    },
    {
      "name": "sync"
    }
  ]
}
