        "value": "={{ JSON.stringify({ job_id: $('Merge Results').first().json.job_id, type: $('Merge Results').first().json.type, status: 'terminate', updated_at: new Date().toISOString(), result: { mongo_id: $('Save to API').first().json._id, title: $('Merge Results').first().json.result.title } }) }}",
        "expire": true,
        "ttl": 300
      },
      "credentials": {
        "redis": {
