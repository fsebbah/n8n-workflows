      "typeVersion": 2.2,
      "position": [680, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.propertyName }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "get-job-data",
      "name": "Get Job Data",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [900, 200],
      "parameters": {
        "operation": "get",
        "key": "=job:learning:{{ $json.propertyName }}"
      },
      "credentials": {
        "redis": {
          "id": "redis-account",
          "name": "Redis account"
        }
      }
    },
    {
      "id": "parse-job",
      "name": "Parse Job Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 200],
      "parameters": {
        "jsCode": "const jobStr = $input.first().json;\ntry {\n  const job = typeof jobStr === 'string' ? JSON.parse(jobStr) : jobStr;\n  return { json: job };\n} catch (e) {\n  return { json: { error: 'Invalid job data', raw: jobStr } };\n}"
      }
    },
    {
      "id": "update-status-generating",
      "name": "Update Status: Generating",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [1340, 200],
      "parameters": {
        "operation": "set",
        "key": "=job:learning:{{ $json.job_id }}",
        "value": "={{ JSON.stringify({ ...$json, status: 'generating', updated_at: new Date().toISOString() }) }}",
        "expire": true,
        "ttl": 3600
      },
      "credentials": {
        "redis": {
          "id": "redis-account",
          "name": "Redis account"
        }
      }
    },
    {
      "id": "check-type",
      "name": "Quiz or Course?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1560, 200],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "quiz",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $('Parse Job Data').first().json.type }}",
                    "rightValue": "quiz",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "course",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $('Parse Job Data').first().json.type }}",
                    "rightValue": "course",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "none"
        }
      }
    },
    {
      "id": "call-claude-quiz",
      "name": "Call Claude (Quiz)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 100],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Parse Job Data').first().json.body.anthropic_api_key }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Parse Job Data').first().json.body.model, max_tokens: $('Parse Job Data').first().json.body.max_tokens || 4096, system: 'Tu génères des quiz structurés. Réponds TOUJOURS en JSON valide avec cette structure exacte: {\"title\": \"string\", \"description\": \"string\", \"instructions\": \"string\", \"questions\": [{\"text\": \"string\", \"type\": \"multiple_choice|true_false|short_answer\", \"options\": [\"string\"] ou null, \"correct_answer\": \"string\", \"explanation\": \"string\", \"difficulty\": 1|2|3, \"order_index\": number, \"points\": number}]}. Ne mets PAS de ```json```, retourne directement le JSON.', messages: [{ role: 'user', content: $('Parse Job Data').first().json.body.prompt }] }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "call-claude-course",
      "name": "Call Claude (Course)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Parse Job Data').first().json.body.anthropic_api_key }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Parse Job Data').first().json.body.model, max_tokens: $('Parse Job Data').first().json.body.max_tokens || 8192, system: 'Tu génères des cours structurés. Réponds TOUJOURS en JSON valide avec cette structure exacte: {\"title\": \"string\", \"description\": \"string\", \"level\": \"string\", \"estimated_duration_minutes\": number, \"modules\": [{\"title\": \"string\", \"description\": \"string\", \"order_index\": number, \"lessons\": [{\"title\": \"string\", \"content\": \"string (markdown)\", \"duration_minutes\": number, \"order_index\": number}]}]}. Ne mets PAS de ```json```, retourne directement le JSON.', messages: [{ role: 'user', content: $('Parse Job Data').first().json.body.prompt }] }) }}",
        "options": {
          "timeout": 600000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "parse-quiz-response",
      "name": "Parse Quiz Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 100],
      "parameters": {
        "jsCode": "const jobData = $('Parse Job Data').first().json;\nconst llmResponse = $input.first().json;\n\ntry {\n  if (llmResponse.error) {\n    throw new Error(llmResponse.error.message || 'Claude API error');\n  }\n\n  const content = llmResponse.content?.[0]?.text || '';\n  let jsonStr = content;\n  const jsonMatch = content.match(/```json\\n?([\\s\\S]*?)\\n?```/);\n  if (jsonMatch) {\n    jsonStr = jsonMatch[1];\n  }\n  \n  const quizData = JSON.parse(jsonStr);\n  \n  // Quiz for MongoDB storage (format API backend)\n  const quiz = {\n    title: quizData.title,\n    topic: jobData.body.topic || '',\n    level: quizData.level || jobData.body.level || 'debutant',\n    guild_id: jobData.body.guild_id,\n    instructor_id: jobData.body.instructor_id || jobData.body.user_id,\n    discord_user_id: jobData.body.user_id,\n    job_id: jobData.job_id,\n    questions: quizData.questions.map((q, i) => {\n      // Convert to API format: choices array + correct_index\n      const choices = q.options || [];\n      const correctIndex = choices.findIndex(c => c === q.correct_answer);\n      return {\n        question: q.text,\n        choices: choices,\n        correct_index: correctIndex >= 0 ? correctIndex : 0,\n        explanation: q.explanation || ''\n      };\n    })\n  };\n  \n  return {\n    json: {\n      success: true,\n      type: 'quiz',\n      result: quiz,\n      job_id: jobData.job_id,\n      discord_channel_id: jobData.body.discord_channel_id,\n      user_id: jobData.body.user_id,\n      bot_token: jobData.body.bot_token\n    }\n  };\n} catch (e) {\n  return {\n    json: {\n      success: false,\n      type: 'quiz',\n      error: e.message,\n      job_id: jobData.job_id,\n      discord_channel_id: jobData.body.discord_channel_id,\n      user_id: jobData.body.user_id,\n      bot_token: jobData.body.bot_token\n    }\n  };\n}"
      }
    },
    {
      "id": "parse-course-response",
      "name": "Parse Course Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 300],
      "parameters": {
        "jsCode": "const jobData = $('Parse Job Data').first().json;\nconst llmResponse = $input.first().json;\n\ntry {\n  if (llmResponse.error) {\n    throw new Error(llmResponse.error.message || 'Claude API error');\n  }\n\n  const content = llmResponse.content?.[0]?.text || '';\n  let jsonStr = content;\n  const jsonMatch = content.match(/```json\\n?([\\s\\S]*?)\\n?```/);\n  if (jsonMatch) {\n    jsonStr = jsonMatch[1];\n  }\n  \n  const courseData = JSON.parse(jsonStr);\n  \n  // Full course for MongoDB storage\n  const course = {\n    title: courseData.title,\n    topic: jobData.body.topic,\n    level: courseData.level || jobData.body.level || 'debutant',\n    description: courseData.description || '',\n    guild_id: jobData.body.guild_id,\n    instructor_id: jobData.body.instructor_id || jobData.body.user_id,\n    discord_user_id: jobData.body.user_id,\n    job_id: jobData.job_id,\n    modules: courseData.modules || []\n  };\n  \n  return {\n    json: {\n      success: true,\n      type: 'course',\n      result: course,\n      job_id: jobData.job_id,\n      discord_channel_id: jobData.body.discord_channel_id,\n      user_id: jobData.body.user_id,\n      bot_token: jobData.body.bot_token\n    }\n  };\n} catch (e) {\n  return {\n    json: {\n      success: false,\n      type: 'course',\n      error: e.message,\n      job_id: jobData.job_id,\n      discord_channel_id: jobData.body.discord_channel_id,\n      user_id: jobData.body.user_id,\n      bot_token: jobData.body.bot_token\n    }\n  };\n}"
      }
    },
    {
      "id": "merge-results",
      "name": "Merge Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [2220, 200],
      "parameters": {
        "mode": "chooseBranch",
        "output": "input1"
      }
    },
