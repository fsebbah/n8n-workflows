    {
      "parameters": {
        "jsCode": "// Merge analysis into result\nconst prevData = $('Check Analyze?').first().json;\nconst analysisResult = $input.first().json;\n\nreturn [{\n  json: {\n    ...prevData,\n    analysis: analysisResult\n  }\n}];"
      },
      "id": "merge-analysis",
      "name": "Merge Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3320, 180]
    },
    {
      "parameters": {
        "jsCode": "// Build final response\nconst data = $input.first().json;\n\n// Start with the main graph\nconst response = {\n  graph: data.graphResult?.graph || data.graphResult,\n  metadata: data.graphResult?.metadata || {}\n};\n\n// Add simplified graph if available\nif (data.simplifiedGraph) {\n  response.simplified = {\n    graph: data.simplifiedGraph.graph,\n    metadata: data.simplifiedGraph.metadata,\n    key_entities: data.simplifiedGraph.key_entities\n  };\n}\n\n// Add analysis if available\nif (data.analysis) {\n  response.analysis = data.analysis;\n}\n\nreturn [{ json: response }];"
      },
