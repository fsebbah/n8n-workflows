      },
      "credentials": {
        "slackOAuth2Api": {
          "id": "GSiEiuKBz8GR5qiD",
          "name": "AlexK Slack account"
        }
      },
      "typeVersion": 2.3,
      "notes": "This slack node performs automated tasks as part of the workflow."
    },
