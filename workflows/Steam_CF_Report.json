          "name": "credentials"
        }
      },
      "retryOnFail": false,
      "typeVersion": 1,
      "id": "node-3c547bdb"
    },
    {
      "name": "Add bind-tools",
      "type": "n8n-nodes-base.executeCommand",
      "color": "#FF8000",
      "notes": "Install bind-tools",
      "position": [
        480,
        180
      ],
      "parameters": {
        "command": "=which dig || apk add bind-tools"
      },
      "retryOnFail": true,
      "typeVersion": 1,
      "continueOnFail": true,
      "waitBetweenTries": 1000,
      "id": "node-a8ed642e"
    },
    {
      "name": "dig check CF",
      "type": "n8n-nodes-base.executeCommand",
      "color": "#FF8000",
      "notes": "Install bind-tools",
      "position": [
        1300,
        -50
      ],
      "parameters": {
        "command": "=dig NS  {{$node[\"Webhook\"].data[\"query\"][\"q\"]}} +short | grep cloudflare.com.$ | wc -l"
      },
      "retryOnFail": true,
      "typeVersion": 1,
      "continueOnFail": true,
      "waitBetweenTries": 1000,
      "id": "node-be916006"
    },
