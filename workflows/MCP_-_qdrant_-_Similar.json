    {
      "parameters": {
        "jsCode": "  const input = $input.first().json;\n  const prevData = $('Validate Input').first().json;\n\n  if (input.result?.vector) {\n    return [{\n      json: {\n        ...prevData,\n        embedding: input.result.vector,\n        source_entity: input.result.payload\n      }\n    }];\n  }\n\n  // Fallback: create embedding from payload\n  const payload = input.result?.payload || {};\n  const searchText = [\n    payload.title || '',\n    payload.description || '',\n    (payload.tags || []).join(' '),\n    payload.content || ''\n  ].join(' ').trim();\n\n  return [{\n    json: {\n      ...prevData,\n      search_text: searchText,\n      source_entity: payload,\n      need_embedding: true\n    }\n  }];"
      },
      "id": "prepare-search-from-id",
