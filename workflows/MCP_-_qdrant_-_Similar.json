      "webhookId": "recipes-similar-webhook"
    },
    {
      "parameters": {
        "jsCode": "  const input = $input.first().json;\n  const body = input.body || input;\n\n  const errors = [];\n\n  if (!body.entity_id && !body.entity) {\n    errors.push('Missing required parameter: entity_id or entity object');\n  }\n  if (!body.entity_type) {\n    errors.push('Missing required parameter: entity_type');\n  }\n  if (!body.qdrant_host) {\n    errors.push('Missing required parameter: qdrant_host');\n  }\n  if (!body.qdrant_port) {\n    errors.push('Missing required parameter: qdrant_port');\n  }\n  if (!body.qdrant_collection) {\n    errors.push('Missing required parameter: qdrant_collection');\n  }\n  if (!body.openai_api_key) {\n    errors.push('Missing required parameter: openai_api_key');\n  }\n\n  if (errors.length > 0) {\n    return [{\n      json: {\n        valid: false,\n        error: {\n          code: 400,\n          message: errors.join(', '),\n          status: 'BAD_REQUEST'\n        }\n      }\n    }];\n  }\n\n  // Build search text from entity\n  let searchText = '';\n  if (body.entity) {\n    const e = body.entity;\n    searchText = [\n      e.title || '',\n      e.description || '',\n      (e.tags || []).join(' '),\n      (e.ingredients || []).map(i => typeof i === 'string' ? i : i.name).join(' '),\n      e.content || ''\n    ].join(' ').trim();\n  }\n\n  const qdrantUrl = `http://${body.qdrant_host}:${body.qdrant_port}`;\n\n  return [{\n    json: {\n      valid: true,\n      entity_id: body.entity_id,\n      entity: body.entity,\n      entity_type: body.entity_type,\n      search_text: searchText,\n      limit: body.limit || 5,\n      exclude_self: body.exclude_self !== false,\n      user_id: body.user_id,\n      qdrant_url: qdrantUrl,\n      qdrant_collection: body.qdrant_collection,\n      openai_api_key: body.openai_api_key\n    }\n  }];"
      },
