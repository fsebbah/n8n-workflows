{
  "name": "Video Transcription",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "video-transcription",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "video-transcription-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-url",
              "leftValue": "={{ $json.body.videoUrl }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-video-url",
      "name": "Has videoUrl?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "errorMessage": "={{ \"No video provided. Please send videoUrl in the request body\" }}"
      },
      "id": "error-no-video",
      "name": "Error: No Video",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [680, 420]
    },
    {
      "parameters": {
        "jsCode": "// Prepare data for Video Transcription node\nconst input = $('Webhook').first().json;\nconst body = input.body || input;\n\n// Get operation from request (default: transcribe)\nconst operation = body.operation || 'transcribe';\n\n// Get optional parameters\nconst outputLanguage = body.language || 'auto';\nconst enableChunking = body.enableChunking === true || body.enableChunking === 'true';\nconst chunkDuration = body.chunkDuration || 10;\nconst videoDuration = body.videoDuration || 0;\nconst model = body.model || 'gemini-2.5-flash';\nconst customInstructions = body.customInstructions || '';\nconst startTime = body.startTime || '';\nconst endTime = body.endTime || '';\n\nreturn [{\n  json: {\n    videoUrl: body.videoUrl,\n    operation,\n    outputLanguage,\n    enableChunking,\n    chunkDuration,\n    videoDuration,\n    model,\n    customInstructions,\n    startTime,\n    endTime,\n    originalRequest: body\n  }\n}];"
      },
      "id": "prepare-config",
      "name": "Prepare Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 180]
    },
    {
      "parameters": {
        "operation": "={{ $json.operation }}",
        "credentialType": "vertexai",
        "videoSource": "url",
        "videoUrl": "={{ $json.videoUrl }}",
        "outputLanguage": "={{ $json.outputLanguage }}",
        "enableChunking": "={{ $json.enableChunking }}",
        "chunkDuration": "={{ $json.chunkDuration }}",
        "videoDuration": "={{ $json.videoDuration }}",
        "startTime": "={{ $json.startTime }}",
        "endTime": "={{ $json.endTime }}",
        "options": {
          "model": "={{ $json.model }}",
          "maxOutputTokens": 16384,
          "customInstructions": "={{ $json.customInstructions }}"
        }
      },
      "id": "video-transcription",
      "name": "Video Transcription",
      "type": "n8n-nodes-video-transcription.videoTranscription",
      "typeVersion": 1,
      "position": [900, 180],
      "credentials": {
        "googleVertexAiApi": {
          "id": "google-vertex-ai",
          "name": "Google Vertex AI account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1120, 180]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Has videoUrl?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has videoUrl?": {
      "main": [
        [
          {
            "node": "Prepare Config",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error: No Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Config": {
      "main": [
        [
          {
            "node": "Video Transcription",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Video Transcription": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
