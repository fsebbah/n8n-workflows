        2140,
        500
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst asyncContext = $('Store Async Context').first().json;\nconst secret = $env.N8N_WEBHOOK_SECRET || 'default-secret';\n\nconst errorResult = {\n  success: false,\n  job_id: asyncContext.job_id,\n  error: {\n    code: 500,\n    message: 'Processing failed. Please check the file format and try again.',\n    status: 'INTERNAL_ERROR'\n  }\n};\n\nconst payload = JSON.stringify(errorResult);\nconst signature = crypto.createHmac('sha256', secret).update(payload).digest('hex');\n\nreturn {\n  json: {\n    callback_url: asyncContext.callback_url,\n    payload: errorResult,\n    signature: signature\n  }\n};"
      }
