    {
      "name": "Get journal reply",
      "type": "n8n-nodes-base.telegramTrigger",
      "position": [
        220,
        240
      ],
      "webhookId": "fe4a6042-d343-4a02-b443-6d32c38e094d",
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
