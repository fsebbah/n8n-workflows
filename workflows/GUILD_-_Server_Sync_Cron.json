{
  "name": "GUILD - Server Sync Cron",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Daily 3am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.backend_api_url }}/api/discord/admin/guilds/cron/refresh-stale",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"stale_days\": 7\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "call-backend",
      "name": "Refresh Stale Guilds",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "backend-service-token",
          "name": "Backend Service Token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-stale",
              "leftValue": "={{ $json.stale_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-stale",
      "name": "Has Stale?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "log-refreshed",
              "name": "log",
              "value": "={{ 'Requested refresh for ' + $json.stale_count + ' stale guilds (not synced in ' + $json.stale_days + '+ days)' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "log-refreshed",
      "name": "Log Refreshed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        200
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "log-none",
              "name": "log",
              "value": "No stale guilds to refresh",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "log-none",
      "name": "Log None",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        920,
        400
      ]
    }
  ],
  "connections": {
    "Daily 3am": {
      "main": [
        [
          {
            "node": "Refresh Stale Guilds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Refresh Stale Guilds": {
      "main": [
        [
          {
            "node": "Has Stale?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Stale?": {
      "main": [
        [
          {
            "node": "Log Refreshed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log None",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
