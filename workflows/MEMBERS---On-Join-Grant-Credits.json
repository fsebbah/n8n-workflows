{
  "name": "MEMBERS---On-Join-Grant-Credits",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "path": "member-join",
        "options": {}
      },
      "id": "member-join-0001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        304
      ],
      "webhookId": "member-join-webhook"
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// VALIDATE INPUT (RFC-006)\n// ============================================\n\nconst input = $input.first().json;\nconst body = input.body || {};\n\n// --- Validate required fields ---\nif (!body.discord_user_id) {\n  return {\n    error: true,\n    error_code: 'MISSING_USER_ID',\n    message: 'Le champ \"discord_user_id\" est requis'\n  };\n}\n\nif (!body.guild_id) {\n  return {\n    error: true,\n    error_code: 'MISSING_GUILD_ID',\n    message: 'Le champ \"guild_id\" est requis'\n  };\n}\n\nif (!body.backend_api_url) {\n  return {\n    error: true,\n    error_code: 'MISSING_BACKEND_API_URL',\n    message: 'Le champ \"backend_api_url\" est requis'\n  };\n}\n\nif (!body.backend_service_token) {\n  return {\n    error: true,\n    error_code: 'MISSING_BACKEND_SERVICE_TOKEN',\n    message: 'Le champ \"backend_service_token\" est requis'\n  };\n}\n\n// --- Return validated data ---\nreturn {\n  error: false,\n  data: {\n    discord_user_id: body.discord_user_id,\n    discord_username: body.discord_username || 'unknown',\n    guild_id: body.guild_id,\n    guild_name: body.guild_name || null,\n    joined_at: body.joined_at || null,\n    backend_api_url: body.backend_api_url,\n    backend_service_token: body.backend_service_token\n  }\n};"
      },
      "id": "member-join-0002",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
