              "id": "check-valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-valid",
      "name": "Input Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_URL}}/api/webhook/account/debit",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Project-ID",
              "value": "={{ $json.project_id }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "discord_user_id",
              "value": "={{ $json.discord_user_id }}"
            },
            {
              "name": "amount",
              "value": "={{ $json.amount }}"
            },
            {
              "name": "reason",
              "value": "={{ $json.reason }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "call-api",
      "name": "Call Debit API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1104,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "// Traiter la reponse de l'API\nconst apiResponse = $input.first().json;\nconst statusCode = apiResponse.statusCode || 500;\nconst body = apiResponse.body || {};\n\n// Reponse success (200)\nif (statusCode === 200 && body.success) {\n  return [{\n    json: {\n      success: true,\n      credits: body.credits || {},\n      statusCode: 200\n    }\n  }];\n}\n\n// Reponse erreur (402, 404, ou autre)\nconst errorResponse = {\n  success: false,\n  error: body.error || {\n    code: statusCode,\n    message: body.message || 'Erreur API inconnue',\n    status: statusCode === 402 ? 'PAYMENT_REQUIRED' : \n            statusCode === 404 ? 'NOT_FOUND' : 'INTERNAL_ERROR'\n  },\n  statusCode: statusCode\n};\n\n// Ajouter credits_remaining si disponible (pour 402)\nif (body.error?.credits_remaining !== undefined) {\n  errorResponse.error.credits_remaining = body.error.credits_remaining;\n}\n\nreturn [{ json: errorResponse }];"
      },
