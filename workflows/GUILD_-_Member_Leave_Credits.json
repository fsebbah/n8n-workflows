{
  "name": "GUILD - Member Leave Credits",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "guild/member/leave",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "webhookId": "guild-member-leave"
    },
    {
      "parameters": {
        "jsCode": "// Extract guild and user info from webhook body\nconst body = $input.first().json.body;\n\nreturn {\n  guild_id: body.guild_id,\n  discord_user_id: body.discord_user_id,\n  username: body.username || 'unknown'\n};"
      },
      "id": "extract-ids",
      "name": "Extract IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Webhook Trigger').first().json.body.backend_api_url || $env.BACKEND_API_URL }}/api/ecommerce/webhook/guild-member-leave",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"guild_id\": \"{{ $json.guild_id }}\",\n  \"discord_user_id\": \"{{ $json.discord_user_id }}\"\n}",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Token",
              "value": "={{ $('Webhook Trigger').first().json.body.backend_service_token || $env.BACKEND_SERVICE_TOKEN }}"
            }
          ]
        }
      },
      "id": "call-backend",
      "name": "Return Credits to Pool",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: $json.success, returned_credits: $json.returned_credits || 0, pool_balance: $json.pool_balance || 0, username: $('Extract IDs').item.json.username }) }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        920,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Extract IDs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract IDs": {
      "main": [
        [
          {
            "node": "Return Credits to Pool",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Return Credits to Pool": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "tags": []
}