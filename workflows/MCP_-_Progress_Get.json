    {
      "parameters": {
        "method": "GET",
        "url": "=https://lichess.org/api/user/{{ $('Parse Progress Response').first().json.lichess_username }}/rating-history",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
