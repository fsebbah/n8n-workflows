        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"user_id\": \"{{ $json.discord_user_id }}\",\n  \"embed\": {\n    \"title\": \"Abonnement annul\\u00e9\",\n    \"description\": \"Votre abonnement Torah a \\u00e9t\\u00e9 annul\\u00e9.\\n\\nVous conservez vos cr\\u00e9dits restants et pouvez continuer \\u00e0 les utiliser.\\n\\nVous pouvez vous r\\u00e9abonner \\u00e0 tout moment avec `/subscribe`.\",\n    \"color\": 15158332,\n    \"footer\": {\n      \"text\": \"Merci d'avoir utilis\\u00e9 Torah !\"\n    }\n  }\n}",
        "options": {
          "timeout": 10000
        }
      },
