{
  "name": "MENTION---On-Mention-Handler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mention",
        "options": {}
      },
      "id": "mention-handler-0001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "mention-webhook"
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// VALIDATE INPUT (RFC-007)\n// ============================================\n\nconst input = $input.first().json;\nconst body = input.body || input;\n\n// --- Validate required fields ---\nconst errors = [];\n\nif (!body.guild_id) errors.push('guild_id requis');\nif (!body.user_id) errors.push('user_id requis');\nif (body.content === undefined) errors.push('content requis');\n\nif (errors.length > 0) {\n  return {\n    valid: false,\n    error: {\n      code: 'VALIDATION_ERROR',\n      message: errors.join(', '),\n      http_status: 400\n    }\n  };\n}\n\n// --- Return validated data ---\nreturn {\n  valid: true,\n  data: {\n    message_id: body.message_id || null,\n    channel_id: body.channel_id || null,\n    guild_id: body.guild_id,\n    user_id: body.user_id,\n    content: body.content || '',\n    username: body.username || 'unknown',\n    display_name: body.display_name || body.username || 'unknown',\n    is_reply: body.is_reply || false,\n    replied_to_bot: body.replied_to_bot || false,\n    conversation_id: body.conversation_id || null\n  }\n};"
      },
      "id": "mention-handler-0002",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "mention-handler-0003",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TORAH_API_URL }}/api/branding/guild/{{ $json.data.guild_id }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "mention-handler-0004",
