{
  "name": "MENTION---On-Mention-Handler",
  "nodes": [
    {
      "parameters": {
        "content": "## RFC-007: Mention Service Handler\n\n**Webhook:** POST /mention\n\n**Input:**\n- guild_id (requis)\n- user_id (requis)\n- content\n- username\n- llm_config (optionnel)\n\n**Flow:**\n1. Validate input\n2. Map guild_id → project_id + branding\n3. Call Process-Question\n4. Call Format-Response\n5. Return MentionResult",
        "width": 280,
        "height": 300,
        "color": 6
      },
      "id": "mention-handler-note",
      "name": "Documentation",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-280, 180]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mention",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "mention-handler-0001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "mention-webhook"
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// VALIDATE INPUT (RFC-007 + RFC-009)\n// ============================================\n\nconst input = $input.first().json;\nconst body = input.body || input;\n\n// --- Validate required fields ---\nconst errors = [];\n\nif (!body.guild_id) errors.push('guild_id requis');\nif (!body.user_id) errors.push('user_id requis');\nif (body.content === undefined) errors.push('content requis');\n\nif (errors.length > 0) {\n  return {\n    valid: false,\n    error: {\n      code: 'VALIDATION_ERROR',\n      message: errors.join(', '),\n      http_status: 400\n    }\n  };\n}\n\n// --- Extract LLM config (RFC-009) ---\nconst llmConfig = body.llm_config || {};\n\n// --- Return validated data ---\nreturn {\n  valid: true,\n  data: {\n    message_id: body.message_id || null,\n    channel_id: body.channel_id || null,\n    guild_id: body.guild_id,\n    user_id: body.user_id,\n    content: body.content || '',\n    username: body.username || 'unknown',\n    display_name: body.display_name || body.username || 'unknown',\n    is_reply: body.is_reply || false,\n    replied_to_bot: body.replied_to_bot || false,\n    conversation_id: body.conversation_id || null\n  },\n  llm_config: {\n    provider: llmConfig.provider || null,\n    openai_api_key: llmConfig.openai_api_key || null,\n    anthropic_api_key: llmConfig.anthropic_api_key || null,\n    google_api_key: llmConfig.google_api_key || null,\n    mistral_api_key: llmConfig.mistral_api_key || null\n  }\n};"
      },
      "id": "mention-handler-0002",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "mention-handler-0003",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TORAH_API_URL }}/api/branding/guild/{{ $json.data.guild_id }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "mention-handler-0004",
      "name": "Get Project Mapping",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 200],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-project",
              "leftValue": "={{ $json.project_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "mention-handler-0005",
      "name": "Has Project?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// MERGE PROJECT + DATA + BRANDING (RFC-009 v2)\n// ============================================\n\nconst branding = $input.first().json;\nconst validatedInput = $('Validate Input').first().json;\n\nreturn {\n  project_id: branding.project_id,\n  data: validatedInput.data,\n  llm_config: validatedInput.llm_config,\n  branding: {\n    name: branding.name || null,\n    scope_prompt: branding.scope_prompt || null,\n    out_of_scope_message: branding.out_of_scope_message || null\n  }\n};"
      },
      "id": "mention-handler-0006",
      "name": "Merge Project + Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 100]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "name",
          "value": "MENTION---Process-Question"
        },
        "options": {}
      },
      "id": "mention-handler-0007",
      "name": "Call Process Question",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [1320, 100]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "name",
          "value": "MENTION---Format-Response"
        },
        "options": {}
      },
      "id": "mention-handler-0008",
      "name": "Call Format Response",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [1540, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, response: $json.response || null, intent: $json.intent || 'unknown', confidence: $json.confidence || 0.5, credits_used: $json.credits_consumed || 0 }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "mention-handler-0009",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1760, 100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: $json.error }) }}",
        "options": {
          "responseCode": "={{ $json.error?.http_status || 400 }}"
        }
      },
      "id": "mention-handler-0010",
      "name": "Respond Validation Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: { code: 'UNKNOWN_GUILD', message: 'Guild non configuré', http_status: 400 } }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "mention-handler-0011",
      "name": "Respond Unknown Guild",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1100, 300]
    }
  ],
