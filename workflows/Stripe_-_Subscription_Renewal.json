    },
    {
      "parameters": {
        "jsCode": "// Prepare success response\nconst calcData = $('Calculate Credits').first().json;\nconst newCredits = $('Add Credits').first().json?.credits || (calcData.current_credits + calcData.credits_to_add);\n\nreturn [{\n  json: {\n    success: true,\n    processed: true,\n    discord_user_id: calcData.discord_user_id,\n    plan: calcData.plan,\n    credits_added: calcData.credits_to_add,\n    new_credits: newCredits\n  }\n}];"
      },
