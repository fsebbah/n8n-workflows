{
  "name": "COURSE---CRUD-Webhooks",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "content": "## COURSE - CRUD Webhooks\n\n**Source:** RFC-025 Section 9\n\n**Description:**\nWebhooks pour les opérations cours:\n- GET /course-list\n- GET /course-get/{slug}\n- POST /course-subscribe\n- POST /course-unsubscribe\n- GET /user-courses/{user_id}\n\nUtilisés par les commandes Discord pour\nla gestion des cours.",
        "height": 300,
        "width": 340,
        "color": 5
      },
      "id": "course-crud-0000",
      "name": "Documentation",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        60
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "course-list",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "course-crud-0001",
      "name": "GET Course List",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        200
      ],
      "webhookId": "course-list"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.API_URL }}/api/courses?include_pricing=true",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "course-crud-0002",
      "name": "API Get Courses",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// FORMAT COURSE LIST RESPONSE\n// ============================================\n\nconst apiResponse = $input.first().json;\n\nif (apiResponse.error || apiResponse.statusCode >= 400) {\n  return {\n    success: false,\n    error: {\n      code: apiResponse.statusCode || 500,\n      message: apiResponse.message || 'Failed to fetch courses'\n    }\n  };\n}\n\nconst courses = apiResponse.data || apiResponse || [];\nconst courseList = Array.isArray(courses) ? courses : [];\n\n// Group by category\nconst byCategory = {};\nfor (const course of courseList) {\n  const category = course.category || 'other';\n  if (!byCategory[category]) {\n    byCategory[category] = [];\n  }\n  byCategory[category].push({\n    id: course.id,\n    slug: course.slug,\n    name: course.name,\n    description: course.short_description || course.description,\n    price_monthly: course.price_monthly,\n    price_onetime: course.price_onetime,\n    category: category,\n    level: course.level,\n    duration_weeks: course.duration_weeks\n  });\n}\n\nreturn {\n  success: true,\n  total: courseList.length,\n  courses: courseList.map(c => ({\n    id: c.id,\n    slug: c.slug,\n    name: c.name,\n    description: c.short_description,\n    price_monthly: c.price_monthly,\n    category: c.category,\n    level: c.level\n  })),\n  by_category: byCategory\n};"
      },
      "id": "course-crud-0003",
      "name": "Format Course List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": "={{ $json.success ? 200 : ($json.error?.code || 500) }}"
        }
      },
      "id": "course-crud-0004",
      "name": "Response Course List",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        860,
        200
      ]
    },
