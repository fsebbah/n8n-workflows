    {
      "parameters": {
        "jsCode": "// ============================================\n// VALIDATE SUBSCRIBE INPUT\n// ============================================\n\nconst input = $input.first().json;\nconst body = input.body || {};\n\nconst errors = [];\nif (!body.user_id && !body.discord_id) errors.push('user_id or discord_id');\nif (!body.course_slug && !body.course_id) errors.push('course_slug or course_id');\n\nif (errors.length > 0) {\n  return {\n    valid: false,\n    error: {\n      code: 400,\n      message: `Missing required fields: ${errors.join(', ')}`\n    }\n  };\n}\n\nreturn {\n  valid: true,\n  user_id: body.user_id,\n  discord_id: body.discord_id,\n  guild_id: body.guild_id,\n  course_slug: body.course_slug,\n  course_id: body.course_id\n};"
      },
      "id": "course-crud-0010",
      "name": "Validate Subscribe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        600
      ]
    },
