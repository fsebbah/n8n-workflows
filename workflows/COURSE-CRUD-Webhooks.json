      "id": "course-crud-0024",
      "name": "API Get User Courses",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        1150
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// FORMAT USER COURSES RESPONSE\n// ============================================\n\nconst apiResponse = $input.first().json;\n\nif (apiResponse.error || apiResponse.statusCode >= 400) {\n  return {\n    success: false,\n    error: {\n      code: apiResponse.statusCode || 500,\n      message: apiResponse.message || 'Failed to fetch user courses'\n    }\n  };\n}\n\nconst coursesData = apiResponse.data || apiResponse || [];\nconst courses = Array.isArray(coursesData) ? coursesData : [];\n\n// Separate active from expired\nconst active = courses.filter(c => c.status === 'active');\nconst expired = courses.filter(c => c.status === 'expired');\n\nreturn {\n  success: true,\n  total: courses.length,\n  active_count: active.length,\n  expired_count: expired.length,\n  courses: active.map(c => ({\n    course_id: c.course_id,\n    course_slug: c.course?.slug,\n    course_name: c.course?.name,\n    access_type: c.access_type,\n    status: c.status,\n    expires_at: c.expires_at,\n    enrolled_at: c.created_at\n  })),\n  expired_courses: expired.map(c => ({\n    course_id: c.course_id,\n    course_name: c.course?.name,\n    expired_at: c.expires_at\n  }))\n};"
      },
      "id": "course-crud-0025",
      "name": "Format User Courses",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        1150
      ]
    },
