    {
      "parameters": {
        "jsCode": "// ============================================\n// FORMAT SUBSCRIBE RESPONSE\n// ============================================\n\nconst apiResponse = $input.first().json;\nconst inputData = $('Validate Subscribe').first().json;\n\nif (apiResponse.error || apiResponse.statusCode >= 400) {\n  return {\n    success: false,\n    error: {\n      code: apiResponse.statusCode || 500,\n      message: apiResponse.message || 'Failed to add course to subscription'\n    }\n  };\n}\n\nconst result = apiResponse.data || apiResponse;\n\nreturn {\n  success: true,\n  message: 'Course added to subscription',\n  course: result.course,\n  subscription_item_id: result.subscription_item_id,\n  prorated_amount: result.prorated_amount\n};"
      },
