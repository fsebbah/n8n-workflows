    {
      "parameters": {
        "jsCode": "// ============================================\n// FORMAT UNSUBSCRIBE RESPONSE\n// ============================================\n\nconst apiResponse = $input.first().json;\n\nif (apiResponse.error || apiResponse.statusCode >= 400) {\n  return {\n    success: false,\n    error: {\n      code: apiResponse.statusCode || 500,\n      message: apiResponse.message || 'Failed to remove course from subscription'\n    }\n  };\n}\n\nconst result = apiResponse.data || apiResponse;\n\nreturn {\n  success: true,\n  message: 'Course removed from subscription',\n  course: result.course,\n  credit_amount: result.credit_amount\n};"
