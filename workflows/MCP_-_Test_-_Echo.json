    },
    {
      "parameters": {
        "jsCode": "const startTime = Date.now();\nconst input = $input.first().json.body || $input.first().json;\nconst hasToken = !!input.access_token;\nconst hasUserId = !!input.user_id;\nconst receivedFields = Object.keys(input);\nreturn [{\n  json: {\n    success: true,\n    data: {\n      echo: input.message || \"No message provided\",\n      received_fields: receivedFields,\n      has_token: hasToken,\n      has_user_id: hasUserId,\n      received_at: new Date().toISOString()\n    },\n    execution_time_ms: Date.now() - startTime\n  }\n}];"
      },
      "name": "Validate and Format",
      "type": "n8n-nodes-base.code",
