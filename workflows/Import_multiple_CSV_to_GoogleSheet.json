      "type": "n8n-nodes-base.filter",
      "position": [
        1720,
        600
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.subscribed }}",
              "value2": "TRUE"
            }
          ]
        }
      },
      "typeVersion": 1,
      "notes": "This filter node performs automated tasks as part of the workflow."
    },
    {
      "id": "4ac13e9d-8523-4ff3-b778-1d9f0dc744e3",
