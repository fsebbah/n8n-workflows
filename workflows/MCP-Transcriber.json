        280
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ { \"success\": false, \"job_id\": $('Prepare Config (Async)').first().json.job_id, \"status\": \"failed\", \"error\": { \"message\": $json.error?.message || \"Transcription failed\", \"code\": \"TRANSCRIPTION_ERROR\" }, \"meta\": { \"provider\": \"gemini\", \"execution_mode\": \"async\", \"operation\": $('Prepare Config (Async)').first().json.operation || \"transcribe\", \"model\": $('Prepare Config (Async)').first().json.model || \"gemini-2.5-flash\" } } }}"
      }
    },
    {
      "parameters": {
        "jsCode": "// Prepare error callback request with HMAC signature (RFC-040)\nconst crypto = require('crypto');\n\nconst result = $('Format Error (Async)').first().json;\nconst callback_url = $('Prepare Config (Async)').first().json.callback_url;\n\nconst secret = $env.N8N_WEBHOOK_SECRET || 'default-secret';\nconst payload = JSON.stringify(result);\nconst signature = crypto.createHmac('sha256', secret).update(payload).digest('hex');\n\nreturn [{\n  json: {\n    callback_url,\n    payload: result,\n    signature\n  }\n}];"
      },
