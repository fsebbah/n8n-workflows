      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "errorMessage": "={{ \"No video provided. Please send videoUrl or videoBase64 in the request body\" }}"
      },
      "id": "error-no-video",
      "name": "Error: No Video",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        680,
        520
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-callback",
              "leftValue": "={{ $json.body.callback_url }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-callback-url",
      "name": "Has Callback URL?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Store job context for async processing\nconst crypto = require('crypto');\nconst input = $('Webhook').first().json;\nconst body = input.body || input;\n\n// Generate or use provided job_id\nconst job_id = body.job_id || crypto.randomUUID();\nconst callback_url = body.callback_url;\n\nreturn [{\n  json: {\n    job_id,\n    callback_url,\n    body\n  }\n}];"
      },
      "id": "store-job-context",
      "name": "Store Job Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        180
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"job_id\": $json.job_id, \"status\": \"processing\" } }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "respond-accepted",
      "name": "Respond 202 Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1100,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "// Prepare data for Video Transcription node (async path)\nconst jobContext = $('Store Job Context').first().json;\nconst body = jobContext.body;\n\n// Get operation from request (default: transcribe)\nconst operation = body.operation || 'transcribe';\n\n// Determine video source type\nconst hasBase64 = !!body.videoBase64;\nconst videoSource = hasBase64 ? 'base64' : 'url';\n\n// Get optional parameters\nconst outputLanguage = body.language || 'auto';\nconst enableChunking = body.enableChunking === true || body.enableChunking === 'true';\nconst chunkDuration = body.chunkDuration || 10;\nconst videoDuration = body.videoDuration || 0;\nconst model = body.model || 'gemini-2.5-flash';\nconst customInstructions = body.customInstructions || '';\nconst startTime = body.startTime || '';\nconst endTime = body.endTime || '';\n\nconst result = {\n  videoSource,\n  operation,\n  outputLanguage,\n  enableChunking,\n  chunkDuration,\n  videoDuration,\n  model,\n  customInstructions,\n  startTime,\n  endTime,\n  job_id: jobContext.job_id,\n  callback_url: jobContext.callback_url,\n  originalRequest: { ...body, videoBase64: body.videoBase64 ? '<base64_data>' : undefined }\n};\n\nif (hasBase64) {\n  result.videoBase64 = body.videoBase64;\n  result.videoMimeType = body.videoMimeType || 'video/mp4';\n} else {\n  result.videoUrl = body.videoUrl;\n}\n\nreturn [{ json: result }];"
      },
      "id": "prepare-config-async",
      "name": "Prepare Config (Async)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        180
      ]
    },
    {
      "parameters": {
        "operation": "={{ $json.operation }}",
        "credentialType": "vertexai",
        "videoSource": "={{ $json.videoSource }}",
        "videoUrl": "={{ $json.videoUrl }}",
        "videoBase64": "={{ $json.videoBase64 }}",
        "videoMimeType": "={{ $json.videoMimeType }}",
        "outputLanguage": "={{ $json.outputLanguage }}",
        "enableChunking": "={{ $json.enableChunking }}",
        "chunkDuration": "={{ $json.chunkDuration }}",
        "videoDuration": "={{ $json.videoDuration }}",
        "startTime": "={{ $json.startTime }}",
        "endTime": "={{ $json.endTime }}",
        "options": {
          "model": "={{ $json.model }}",
          "maxOutputTokens": 16384,
          "customInstructions": "={{ $json.customInstructions }}"
        }
      },
      "id": "video-transcription-async",
      "name": "Video Transcription (Async)",
      "type": "n8n-nodes-video-transcription.videoTranscription",
      "typeVersion": 1,
      "position": [
        1500,
        180
      ],
      "credentials": {
        "googleVertexAiApi": {
          "id": "Yis7YQJ8FMrvHGzl",
          "name": "Google Vertex AI account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "format-output-async",
      "name": "Format Output (Async)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1700,
        80
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ { \"success\": true, \"job_id\": $('Prepare Config (Async)').first().json.job_id, \"status\": \"completed\", \"data\": $json, \"meta\": { \"provider\": \"gemini\", \"execution_mode\": \"async\", \"operation\": $('Prepare Config (Async)').first().json.operation || \"transcribe\", \"model\": $('Prepare Config (Async)').first().json.model || \"gemini-2.5-flash\" } } }}"
      }
    },
    {
      "parameters": {
        "jsCode": "// Prepare callback request with HMAC signature (RFC-040)\nconst crypto = require('crypto');\n\nconst result = $('Format Output (Async)').first().json;\nconst callback_url = $('Prepare Config (Async)').first().json.callback_url;\n\nconst secret = $env.N8N_WEBHOOK_SECRET || 'default-secret';\nconst payload = JSON.stringify(result);\nconst signature = crypto.createHmac('sha256', secret).update(payload).digest('hex');\n\nreturn [{\n  json: {\n    callback_url,\n    payload: result,\n    signature\n  }\n}];"
      },
      "id": "prepare-callback",
      "name": "Prepare Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.callback_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-N8N-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.payload }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "send-callback",
      "name": "Send Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2100,
        80
      ]
    },
    {
