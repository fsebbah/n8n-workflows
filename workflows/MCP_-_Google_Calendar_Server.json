    {
      "parameters": {
        "jsCode": "// ── azy.daily#645 — rendre l'échec LISIBLE, au lieu d'un 200 à corps vide ────\n//\n// Avant : les nœuds *ToolDynamic levaient, le workflow mourait avant son\n// `respondToWebhook`, et n8n fermait la requête en HTTP 200 SANS CORPS. Trois\n// causes très différentes produisaient ce même vide, et aucun appelant ne pouvait\n// les distinguer d'une boîte réellement vide :\n//     route morte · refus d'autorisation de Google · paire resource/operation non routée\n// MCP le dit explicitement : son `_normalize_response` traduisait ce vide en\n// `success=True, data=[]`, c'est-à-dire « boîte vide ».\n//\n// Maintenant : les nœuds portent `onError: continueRegularOutput`, donc leur\n// erreur ARRIVE ICI comme une donnée, et ce nœud la qualifie.\n//\n// ⚠️ `JSON.stringify` LAISSE TOMBER les clés `undefined` (n8n-workflows#467, c'est\n// ainsi que GUILD - Server Sync avait perdu son champ `success`). Chaque clé est\n// donc posée explicitement, jamais laissée indéfinie.\n\nconst entree = $input.first().json || {};\n\nconst enveloppe = (code, message, statut, detail) => ({\n  success: false,\n  data: null,\n  // ⚠️ Le code est publié DEUX FOIS, volontairement. MCP lit un `error_code` À PLAT\n  // dans le corps (`_normalize_response`) ; le publier aussi à la racine leur évite\n  // toute adaptation et fait remonter nos codes stables au lieu d'un générique.\n  // Les deux valeurs viennent de la MÊME variable : elles ne peuvent pas diverger.\n  error_code: code,\n  error: {\n    code: code,                       // stable, fait pour être testé par l'appelant\n    message: String(message || 'Erreur inconnue'),\n    http_status: statut,\n  },\n  _trace: {\n    http_status: statut,\n    noeud: String(detail || ''),\n  },\n});\n\n// 1 · Paire resource/operation non routée (vient du nœud `Route inconnue`).\nif (entree._route_inconnue === true) {\n  return enveloppe(\n    'TOOL_ROUTE_UNKNOWN',\n    entree._message || 'Paire resource/operation non routée par ce serveur',\n    400,\n    'Route by Operation');\n}\n\n// 2 · Le nœud a échoué et nous a transmis son erreur.\nconst brut = String(entree.error || '');\nif (brut) {\n  // ⚠️ L'ordre compte : « Unknown … operation » doit être reconnu AVANT les codes\n  // HTTP, car il ne porte aucun statut — c'est un défaut de CÂBLAGE chez nous, pas\n  // un refus de Google. Le confondre avec une erreur d'API ferait chercher la\n  // panne du mauvais côté.\n  if (/Unknown\\s+\\w+\\s+operation/i.test(brut)) {\n    return enveloppe('TOOL_OPERATION_UNKNOWN', brut, 501, 'nœud dynamique');\n  }\n  if (/Authorization failed/i.test(brut) || /\\b40[13]\\b/.test(brut)) {\n    return enveloppe('GOOGLE_AUTH_REJECTED',\n                     'Google a refusé le jeton fourni dans le corps de la requête',\n                     401, 'nœud dynamique');\n  }\n  if (/\\b404\\b/.test(brut) || /not found/i.test(brut)) {\n    return enveloppe('GOOGLE_NOT_FOUND', brut, 404, 'nœud dynamique');\n  }\n  if (/\\b429\\b/.test(brut) || /rate limit/i.test(brut) || /quota/i.test(brut)) {\n    return enveloppe('GOOGLE_RATE_LIMITED', brut, 429, 'nœud dynamique');\n  }\n  return enveloppe('GOOGLE_API_ERROR', brut, 502, 'nœud dynamique');\n}\n\n// 3 · Succès. `data` porte la réponse de Google telle quelle — on n'enlève et on\n// n'ajoute rien : c'est ce qui permet de comparer le direct et le via-n8n.\nreturn {\n  success: true,\n  data: entree,\n  error_code: null,          // présent et nul : la forme ne change pas selon l'issue\n  error: null,\n  _trace: { http_status: 200, noeud: '' },\n};\n"
      },
      "id": "qualifier-645",
      "name": "Qualifier la réponse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// ── azy.daily#645 — la troisième cause du « 200 vide » ───────────────────────\n//\n// Le `Switch` portait `fallbackOutput: none` : une paire resource/operation qu'il\n// ne connaît pas ne produisait AUCUNE sortie, le workflow se terminait sans rien,\n// et n8n fermait en 200 vide. Il porte maintenant une sortie de repli, câblée ici.\n//\n// Ce chemin est loin d'être théorique : la route backend-to-backend de MCP\n// (`POST /api/tools/{tool_id}/execute`) relaie `operation` VERBATIM, sans le\n// valider contre les opérations gérées. N'importe quelle valeur peut donc arriver.\n//\n// ⚠️ On n'écho PAS le corps reçu : il contient le jeton OAuth. Seuls `resource` et\n// `operation` sont repris, et rien d'autre.\nconst corps = ($input.first().json || {}).body || {};\nreturn {\n  _route_inconnue: true,\n  _message: 'Paire non routée par ce serveur : resource=' +\n            JSON.stringify(corps.resource === undefined ? null : corps.resource) +\n            ', operation=' +\n            JSON.stringify(corps.operation === undefined ? null : corps.operation),\n};\n"
      },
      "id": "route-inconnue-645",
      "name": "Route inconnue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        720
      ]
    }
  ],
