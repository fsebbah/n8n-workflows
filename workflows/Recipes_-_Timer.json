    {
      "id": "validate-input",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\n\nconst errors = [];\nconst action = body.action || 'create';\n\n// Common validation\nif (!body.user_id) {\n  errors.push('Missing required parameter: user_id');\n}\n\n// Action-specific validation\nif (action === 'create') {\n  // discord_channel_id is optional (used for tracking, not required for DM notifications)\n  if (!body.label) {\n    errors.push('Missing required parameter: label');\n  }\n  if (!body.duration_minutes) {\n    errors.push('Missing required parameter: duration_minutes');\n  } else if (body.duration_minutes < 1 || body.duration_minutes > 1440) {\n    errors.push('duration_minutes must be between 1 and 1440 (24h max)');\n  }\n} else if (action === 'cancel') {\n  if (!body.timer_id) {\n    errors.push('Missing required parameter: timer_id');\n  }\n}\n\nif (errors.length > 0) {\n  return [{\n    json: {\n      valid: false,\n      error: {\n        code: 400,\n        message: errors.join(', '),\n        status: 'BAD_REQUEST'\n      }\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    action: action,\n    user_id: body.user_id,\n    discord_channel_id: body.discord_channel_id || null,  // Optional - for tracking\n    timer_id: body.timer_id,\n    label: body.label,\n    duration_minutes: body.duration_minutes,\n    recipe_id: body.recipe_id,\n    recipe_title: body.recipe_title,\n    status_filter: body.status || 'active',\n    api_base_url: body.api_base_url || process.env.API_BASE_URL || 'http://api.torah.solutions/api'\n  }\n}];"
      }
    },
