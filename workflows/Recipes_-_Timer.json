    {
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        260
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst prevData = $('Validate Input').first().json;\n\ntry {\n  // Check for API error\n  if (input.detail) {\n    return [{\n      json: {\n        success: false,\n        error: {\n          code: 404,\n          message: input.detail,\n          status: 'NOT_FOUND'\n        },\n        meta: { provider: 'api', action: prevData.action }\n      }\n    }];\n  }\n\n  // Format based on action\n  if (prevData.action === 'create') {\n    return [{\n      json: {\n        success: true,\n        data: {\n          timer_id: input.id,\n          label: input.label,\n          duration_minutes: input.duration_minutes,\n          expires_at: input.expires_at,\n          status: input.status\n        },\n        meta: { provider: 'api', action: 'create' }\n      }\n    }];\n  } else if (prevData.action === 'list') {\n    const timers = (input.timers || []).map(t => ({\n      timer_id: t.id,\n      label: t.label,\n      duration_minutes: t.duration_minutes,\n      expires_at: t.expires_at,\n      remaining_seconds: t.remaining_seconds,\n      recipe_title: t.recipe_title,\n      status: t.status\n    }));\n    return [{\n      json: {\n        success: true,\n        data: {\n          timers: timers,\n          total: input.total || timers.length\n        },\n        meta: { provider: 'api', action: 'list' }\n      }\n    }];\n  } else if (prevData.action === 'cancel') {\n    return [{\n      json: {\n        success: true,\n        data: {\n          message: input.message || 'Timer cancelled'\n        },\n        meta: { provider: 'api', action: 'cancel' }\n      }\n    }];\n  }\n\n  return [{ json: { success: true, data: input, meta: { provider: 'api' } } }];\n} catch (e) {\n  return [{\n    json: {\n      success: false,\n      error: {\n        code: 500,\n        message: 'Failed to process API response: ' + e.message,\n        status: 'PROCESS_ERROR'\n      },\n      meta: { provider: 'api' }\n    }\n  }];\n}"
      }
    },
