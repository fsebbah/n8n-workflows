        "jsonBody": "={\n  \"student_id\": \"{{ $('Lookup Student (Backend)').item.json.student.id }}\",\n  \"discord_user_id\": \"{{ $('Webhook').item.json.body.discord_user_id }}\",\n  \"discord_channel_id\": \"{{ $json.data?.channel_id || null }}\"\n}",
        "options": {}
      },
      "id": "callback-backend-with-channel",
      "name": "Callback Backend (with channel)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1790, 50],
      "credentials": {
        "httpHeaderAuth": {
