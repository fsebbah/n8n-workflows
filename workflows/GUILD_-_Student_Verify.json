    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/discord/commands/set-permissions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"guild_id\": \"{{ $('Webhook').item.json.body.guild_id }}\",\n  \"channel_id\": \"{{ $json.group.discord_channel_id }}\",\n  \"target_id\": \"{{ $('Webhook').item.json.body.discord_user_id }}\",\n  \"target_type\": \"member\",\n  \"allow\": [\"view_channel\", \"send_messages\", \"read_message_history\"]\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "add-to-group-channel",
      "name": "Add to Group Channel (via Backend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [910, 150],
      "credentials": {
        "httpHeaderAuth": {
