    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-personal-enabled",
              "leftValue": "={{ $('Lookup Student (Backend)').item.json.group.personal_channels_enabled }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-personal-channel",
      "name": "Personal Channel Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1130, 150]
    },
    {
      "parameters": {
        "jsCode": "// Prepare data for POST /api/discord/commands/create-channel\nconst studentData = $('Lookup Student (Backend)').item.json;\nconst discordUserId = $('Webhook').item.json.body.discord_user_id;\nconst guildId = $('Webhook').item.json.body.guild_id;\n\n// Build permission_overwrites in API format\nconst permissionOverwrites = [\n  {\n    id: guildId,\n    type: 0,  // role\n    deny: \"1024\"  // VIEW_CHANNEL denied for @everyone\n  },\n  {\n    id: discordUserId,\n    type: 1,  // member\n    allow: \"68608\"  // VIEW + SEND + HISTORY for student\n  }\n];\n\n// Add profs role if configured\nif (studentData.group.profs_role_discord_id) {\n  permissionOverwrites.push({\n    id: studentData.group.profs_role_discord_id,\n    type: 0,  // role\n    allow: \"68608\"  // VIEW + SEND + HISTORY for profs\n  });\n}\n\nreturn {\n  guild_id: guildId,\n  name: studentData.group.channel_name,\n  parent_id: studentData.group.personal_channel_category_discord_id || null,\n  topic: `Channel personnel ${studentData.student.firstname} ${studentData.student.lastname}`,\n  private: true,\n  permission_overwrites: permissionOverwrites\n};"
      },
      "id": "prepare-personal-channel",
      "name": "Prepare Personal Channel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1350, 50]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/discord/commands/create-channel",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "create-personal-channel",
      "name": "Create Personal Channel (via Backend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1570, 50],
      "credentials": {
        "httpHeaderAuth": {
          "id": "backend-api",
          "name": "Backend API"
        }
      }
    },
    {
      "parameters": {
