    },
    {
      "parameters": {
        "url": "={{ $env.API_URL }}/api/talmud/traites",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          },
          "timeout": 30000
        }
      },
      "id": "get-global-status",
      "name": "Get Global Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1072,
        400
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Formater la réponse pour un traité spécifique (liste des pages)\nconst input = $input.first().json;\nconst params = $('Parse Parameters').first().json;\n\nconst data = input.body || input;\nconst statusCode = input.statusCode || 200;\n\nif (statusCode >= 400 || data.error) {\n  return [{\n    json: {\n      success: false,\n      error: {\n        code: statusCode,\n        message: data.error?.message || data.message || 'Erreur API Torah',\n        status: 'API_ERROR'\n      }\n    }\n  }];\n}\n\n// Liste des pages du traité\nconst pages = data.pages || [];\n\n// Construire la réponse\nconst response = {\n  success: true,\n  type: 'traite_pages',\n  traite: data.traite || params.traite,\n  total_pages: pages.length,\n  pages: pages,\n  discord: params.discord\n};\n\nreturn [{ json: response }];"
      },
      "id": "format-traite-response",
      "name": "Format Traite Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "// Formater la réponse globale avec statistiques\nconst input = $input.first().json;\nconst params = $('Parse Parameters').first().json;\n\nconst webhook = $env.N8N_BASE_URL;\nconst webhookBase = $env.N8N_WEBHOOK_BASE_URL;\nconst apiUrl = $env.API_URL;\n\nconst data = input.body || input;\nconst statusCode = input.statusCode || 200;\n\nif (statusCode >= 400 || data.error) {\n  return [{\n    json: {\n      success: false,\n      error: {\n        code: statusCode,\n        message: data.error?.message || data.message || 'Erreur API Torah',\n        status: 'API_ERROR'\n      }\n    }\n  }];\n}\n\n// Liste des traités\nconst traites = data.traites || [];\n\n// Récupérer le nombre de pages pour chaque traité\nlet totalPages = 0;\nconst traitesWithPages = [];\n\nfor (const traite of traites) {\n  try {\n    const pageData = await this.helpers.httpRequest({\n      method: 'GET',\n      url: `${apiUrl}/api/talmud/traite/${encodeURIComponent(traite)}/pages`,\n      json: true\n    });\n    const pageCount = pageData.pages ? pageData.pages.length : 0;\n    totalPages += pageCount;\n    traitesWithPages.push({ name: traite, pages: pageCount });\n  } catch (e) {\n    traitesWithPages.push({ name: traite, pages: 0 });\n  }\n}\n\n// Construire la réponse avec statistics\nconst response = {\n  success: true,\n  statistics: {\n    total_traites: traites.length,\n    total_pages: totalPages,\n    translated: 0,\n    pending: totalPages,\n    percentage: 0\n  },\n  traites: traitesWithPages,\n  traites_not_started: traites,\n  discord: params.discord\n};\n\nreturn [{ json: response }];"
      },
      "id": "format-global-response",
      "name": "Format Global Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        400
      ]
    },
    {
      "parameters": {
