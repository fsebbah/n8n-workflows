      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.discord.webhook_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"embeds\": [{\n    \"title\": \"{{ $json.type === 'traite_pages' ? '📖 ' + $json.traite : '📚 Statut des Traductions' }}\",\n    \"color\": 5763719,\n    \"fields\": [\n      {{ $json.statistics ? '{\"name\": \"Progression\", \"value\": \"' + $json.statistics.translated + '/' + $json.statistics.total_pages + ' pages (' + $json.statistics.percentage + '%)\", \"inline\": true}' : '' }}\n      {{ $json.statistics ? ',{\"name\": \"Traités\", \"value\": \"' + $json.statistics.total_traites + ' traités\", \"inline\": true}' : '' }}\n      {{ $json.traites_not_started && $json.traites_not_started.length > 0 ? ',{\"name\": \"Non commencés\", \"value\": \"' + $json.traites_not_started.slice(0,5).join(', ') + ($json.traites_not_started.length > 5 ? '...' : '') + '\", \"inline\": false}' : '' }}\n      {{ $json.type === 'traite_pages' ? '{\"name\": \"Total pages\", \"value\": \"' + $json.total_pages + ' pages\", \"inline\": true}' : '' }}\n      {{ $json.type === 'traite_pages' ? ',{\"name\": \"Pages\", \"value\": \"' + $json.pages.slice(0,15).join(', ') + ($json.pages.length > 15 ? '...' : '') + '\", \"inline\": false}' : '' }}\n    ],\n    \"footer\": { \"text\": \"Torah API\" },\n    \"timestamp\": \"{{ new Date().toISOString() }}\"\n  }]\n}",
        "options": {
          "timeout": 10000
        }
      },
