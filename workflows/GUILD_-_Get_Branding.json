  "nodes": [
    {
      "parameters": {
        "content": "## GUILD - Get Branding\n\n**Endpoint:** `POST /webhook/guild-get-branding`\n\n**Payload:**\n```json\n{\"guild_id\": \"123456789\"}\n```\n\n**API Backend:** `GET /api/guilds/{guild_id}/branding`\n\n**Scope:** `branding:read`",
        "height": 220,
        "width": 400,
        "color": 6
      },
