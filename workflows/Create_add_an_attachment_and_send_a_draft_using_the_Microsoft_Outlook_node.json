      "type": "n8n-nodes-base.microsoftOutlook",
      "position": [
        850,
        300
      ],
      "parameters": {
        "resource": "messageAttachment",
        "messageId": "={{$node[\"Microsoft Outlook\"].json[\"id\"]}}",
        "additionalFields": {
          "fileName": "n8n.png"
        }
      },
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": null,
          "name": "Micrsoft Outlook Credentials"
        }
      },
