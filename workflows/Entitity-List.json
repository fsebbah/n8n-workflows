        "jsCode": "  const input = $input.first().json;\n  const prevData = $('Validate Input').first().json;\n\n  try {\n    // Check for API error\n    if (input.detail) {\n      return [{\n        json: {\n          success: false,\n          error: {\n            code: 404,\n            message: input.detail,\n            status: 'NOT_FOUND'\n          },\n          meta: {\n            provider: 'api',\n            action: prevData.action,\n            entity_type: prevData.entity_type\n          }\n        }\n      }];\n    }\n\n    // Format based on action\n    if (prevData.action === 'list') {\n      // La réponse API peut avoir différentes structures selon entity_type\n      const items = input.items || input.recipes || input.translations || input.data || [];\n      return [{\n        json: {\n          success: true,\n          data: {\n            items: items,\n            total: input.total || items.length,\n            limit: prevData.limit,\n            offset: prevData.offset,\n            entity_type: prevData.entity_type\n          },\n          meta: { provider: 'api', action: 'list', entity_type: prevData.entity_type }\n        }\n      }];\n    } else if (prevData.action === 'get') {\n      return [{\n        json: {\n          success: true,\n          data: {\n            entity: input,\n            entity_type: prevData.entity_type\n          },\n          meta: { provider: 'api', action: 'get', entity_type: prevData.entity_type }\n        }\n      }];\n    } else if (prevData.action === 'delete') {\n      return [{\n        json: {\n          success: true,\n          data: {\n            message: input.message || 'Entity deleted',\n            entity_type: prevData.entity_type\n          },\n          meta: { provider: 'api', action: 'delete', entity_type: prevData.entity_type }\n        }\n      }];\n    }\n\n    return [{\n      json: {\n        success: true,\n        data: input,\n        meta: { provider: 'api', entity_type: prevData.entity_type }\n      }\n    }];\n  } catch (e) {\n    return [{\n      json: {\n        success: false,\n        error: {\n          code: 500,\n          message: 'Failed to process API response: ' + e.message,\n          status: 'PROCESS_ERROR'\n        },\n        meta: { provider: 'api', entity_type: prevData.entity_type }\n      }\n    }];\n  }"
