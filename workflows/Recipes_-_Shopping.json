    {
      "id": "validate-input",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\n\nconst errors = [];\nconst action = body.action || 'get';\n\n// Common validation\nif (!body.user_id) {\n  errors.push('Missing required parameter: user_id');\n}\n\n// Action-specific validation\nif (action === 'add') {\n  if (!body.name) {\n    errors.push('Missing required parameter: name');\n  }\n} else if (action === 'add_from_recipe') {\n  if (!body.recipe_id) {\n    errors.push('Missing required parameter: recipe_id');\n  }\n} else if (action === 'check' || action === 'remove') {\n  if (!body.item_id) {\n    errors.push('Missing required parameter: item_id');\n  }\n}\n\nif (errors.length > 0) {\n  return [{\n    json: {\n      valid: false,\n      error: {\n        code: 400,\n        message: errors.join(', '),\n        status: 'BAD_REQUEST'\n      }\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    action: action,\n    user_id: body.user_id,\n    item_id: body.item_id,\n    recipe_id: body.recipe_id,\n    // Item data\n    name: body.name,\n    quantity: body.quantity,\n    unit: body.unit,\n    category: body.category,\n    is_checked: body.is_checked,\n    // Clear options\n    checked_only: body.checked_only || false,\n    api_base_url: body.api_base_url || process.env.API_BASE_URL || 'http://api.torah.solutions/api'\n  }\n}];"
      }
    },
