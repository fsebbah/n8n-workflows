    {
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        260
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst prevData = $('Validate Input').first().json;\n\ntry {\n  // Check for API error\n  if (input.detail) {\n    return [{\n      json: {\n        success: false,\n        error: {\n          code: 404,\n          message: input.detail,\n          status: 'NOT_FOUND'\n        },\n        meta: { provider: 'api', action: prevData.action }\n      }\n    }];\n  }\n\n  // Format based on action\n  if (prevData.action === 'get') {\n    const items = (input.items || []).map(i => ({\n      id: i.id,\n      name: i.name,\n      quantity: i.quantity,\n      unit: i.unit,\n      is_checked: i.is_checked,\n      category: i.category,\n      recipe_id: i.recipe_id\n    }));\n    return [{\n      json: {\n        success: true,\n        data: {\n          list_id: input.id,\n          name: input.name,\n          items: items,\n          total_items: items.length,\n          checked_items: items.filter(i => i.is_checked).length\n        },\n        meta: { provider: 'api', action: 'get' }\n      }\n    }];\n  } else if (prevData.action === 'add') {\n    return [{\n      json: {\n        success: true,\n        data: {\n          item_id: input.id,\n          name: input.name,\n          message: 'Item added to shopping list'\n        },\n        meta: { provider: 'api', action: 'add' }\n      }\n    }];\n  } else if (prevData.action === 'add_from_recipe') {\n    return [{\n      json: {\n        success: true,\n        data: {\n          items_added: input.items_added || 0,\n          message: input.message || 'Ingredients added'\n        },\n        meta: { provider: 'api', action: 'add_from_recipe' }\n      }\n    }];\n  } else if (prevData.action === 'check') {\n    return [{\n      json: {\n        success: true,\n        data: {\n          item_id: input.id,\n          is_checked: input.is_checked,\n          message: input.is_checked ? 'Item checked' : 'Item unchecked'\n        },\n        meta: { provider: 'api', action: 'check' }\n      }\n    }];\n  } else if (prevData.action === 'remove') {\n    return [{\n      json: {\n        success: true,\n        data: {\n          message: input.message || 'Item removed'\n        },\n        meta: { provider: 'api', action: 'remove' }\n      }\n    }];\n  } else if (prevData.action === 'clear') {\n    return [{\n      json: {\n        success: true,\n        data: {\n          items_removed: input.items_removed || 0,\n          message: input.message || 'List cleared'\n        },\n        meta: { provider: 'api', action: 'clear' }\n      }\n    }];\n  }\n\n  return [{ json: { success: true, data: input, meta: { provider: 'api' } } }];\n} catch (e) {\n  return [{\n    json: {\n      success: false,\n      error: {\n        code: 500,\n        message: 'Failed to process API response: ' + e.message,\n        status: 'PROCESS_ERROR'\n      },\n      meta: { provider: 'api' }\n    }\n  }];\n}"
      }
