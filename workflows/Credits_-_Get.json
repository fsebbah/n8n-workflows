    {
      "parameters": {
        "url": "={{$env.API_URL}}/api/webhook/account/logs?project_id={{ $json.project_id }}&discord_user_id={{ $json.discord_user_id }}&limit=5",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 10000
        }
      },
      "id": "get-logs",
      "name": "Get Logs (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1008,
        352
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "id": "merge-results",
      "name": "Merge Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1232,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst inputData = $('Validate Input').first().json;\n\n// Trouver les reponses des 2 APIs\nlet creditsResponse = null;\nlet logsResponse = null;\n\nfor (const item of items) {\n  const data = item.json;\n  if (data.credits !== undefined) {\n    creditsResponse = data;\n  } else if (data.logs !== undefined) {\n    logsResponse = data;\n  }\n}\n\n// Verifier si les credits existent\nif (!creditsResponse || !creditsResponse.success) {\n  return [{\n    json: {\n      success: false,\n      error: {\n        code: 404,\n        message: `Aucun compte trouve pour discord_user_id '${inputData.discord_user_id}' dans le projet '${inputData.project_id}'`,\n        status: 'NOT_FOUND'\n      }\n    }\n  }];\n}\n\nconst credits = creditsResponse.credits || {};\nconst logs = logsResponse?.logs || [];\n\n// Calculer les stats\nconst creditsRemaining = credits.credits_remaining || 0;\nconst creditsTotal = credits.credits_total || 0;\nconst creditsUsed = creditsTotal - creditsRemaining;\nconst usagePercent = creditsTotal > 0 \n  ? Math.round((creditsUsed / creditsTotal) * 100) \n  : 0;\n\n// Formater les transactions\nconst recentTransactions = logs.map(log => ({\n  id: log.id,\n  type: log.operation,\n  amount: log.amount,\n  description: log.reason,\n  created_at: log.created_at\n}));\n\nreturn [{\n  json: {\n    success: true,\n    balance: {\n      project_id: credits.project_id || inputData.project_id,\n      discord_user_id: credits.discord_user_id || inputData.discord_user_id,\n      credits_remaining: creditsRemaining,\n      credits_total: creditsTotal,\n      credits_used: creditsUsed,\n      usage_percent: usagePercent,\n      subscription_status: credits.subscription_status || null,\n      renewal_date: credits.current_period_end || null,\n      recent_transactions: recentTransactions,\n      updated_at: credits.updated_at || null\n    }\n  }\n}];"
      },
