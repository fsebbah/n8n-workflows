    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst query = input.query || {};\nconst body = input.body || {};\nconst ctx = body.context || {};\nconst projectId = query.project_id || null;\nconst discordUserId = query.discord_user_id || null;\nconst backendApiUrl = body.backend_api_url || ctx.backend_api_url;\nconst backendServiceToken = body.backend_service_token || ctx.backend_service_token;\n\n\nconst errors = [];\nif (!projectId) errors.push('project_id');\nif (!discordUserId) errors.push('discord_user_id');\n\nif (errors.length > 0) {\n  return [{\n    json: {\n      valid: false,\n      error: {\n        code: 400,\n        message: `Parametres requis manquants: ${errors.join(', ')}`,\n        status: 'BAD_REQUEST'\n      }\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    project_id: projectId,\n    discord_user_id: discordUserId,\n    backend_api_url: backendApiUrl,\n    backend_service_token: backendServiceToken,    \n  }\n}];"
      },
