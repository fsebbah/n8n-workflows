    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// COLLECT OPERATION RESULTS\n// ============================================\n\nconst items = $input.all();\n\n// This node collects results from each batch iteration\nconst result = items[0]?.json || {};\n\nreturn {\n  operation_result: result,\n  success: !result.error && result.statusCode !== 500\n};"
      },
      "id": "stripe-sub-updated-0016",
      "name": "Collect Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2840,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// PREPARE REDIS EVENT\n// ============================================\n\nconst prepData = $('Prepare Operations').first().json;\n\n// Prepare event for Redis Stream (RFC-023 format)\nconst event = {\n  event: 'subscription.updated',\n  guild_id: prepData.guild_id,\n  timestamp: new Date().toISOString(),\n  data: {\n    user_id: prepData.user_id,\n    discord_id: prepData.discord_id,\n    subscription_id: prepData.subscription_id,\n    courses_granted: prepData.grant_count,\n    courses_revoked: prepData.revoke_count\n  }\n};\n\nreturn {\n  event_id: prepData.event_id,\n  stream_name: 'learning:events:stream',\n  event: event,\n  grant_count: prepData.grant_count,\n  revoke_count: prepData.revoke_count\n};"
      },
      "id": "stripe-sub-updated-0017",
      "name": "Prepare Redis Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3060,
        100
      ]
    },
    {
      "parameters": {
        "operation": "xAdd",
        "key": "={{ $json.stream_name }}",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldName": "event",
              "fieldValue": "={{ JSON.stringify($json.event) }}"
            }
          ]
        }
      },
      "id": "stripe-sub-updated-0018",
      "name": "Publish Event",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        3280,
        100
      ],
      "credentials": {
        "redis": {
          "id": "2idv3VKZ91q5gOnz",
          "name": "Redis account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ handled: true, event_id: $('Prepare Redis Event').first().json.event_id, courses_granted: $('Prepare Redis Event').first().json.grant_count, courses_revoked: $('Prepare Redis Event').first().json.revoke_count }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "stripe-sub-updated-0019",
      "name": "Response Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        3500,
