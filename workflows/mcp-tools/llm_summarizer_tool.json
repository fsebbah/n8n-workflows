          }
        ],
        [
          {
            "node": "Mistral Summarize",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Anthropic Summarize (Default)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Summarize": {
      "main": [
        [
          {
