            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error: No Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route Provider": {
      "main": [
        [
          {
            "node": "OpenAI Summarize",
            "type": "main",
